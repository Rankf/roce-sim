+bool
+HanGuRnic::MrRescModule::continueChunk(MrReqRspPtr req) {
+    if (req->sgeListFetch) {
+        req->sgeListFetch = false;
+        SgeDesc *fetched = reinterpret_cast<SgeDesc *>(req->data);
+        req->sgeEntries.assign(fetched, fetched + req->sgeCount);
+        req->sgeList = req->sgeEntries.data();
+        for (uint32_t index = 0; index < req->sgeCount; ++index) {
+            HANGU_PRINT(MrResc, " SGE_FETCH req %p index %u vaddr 0x%lx key 0x%x len %u offset %u total %u\n",
+                req.get(), index, req->sgeList[index].lVaddr,
+                req->sgeList[index].lkey, req->sgeList[index].len,
+                req->sgeOffset, req->sgeTotalLength);
+        }
+        req->type = req->sgeDataType;
+        req->chnl = req->sgeDataChannel;
+        req->data = req->sgeDataBase;
+        req->length = req->sgeTotalLength;
+        req->bytesDone = 0;
+        req->chunkOffset = 0;
+        req->chunkLength = 0;
+    }
+    if (req->sgeCount) {
+        uint64_t completed = req->bytesDone + req->chunkLength;
+        if (completed >= req->length) {
+            return false;
+        }
+        uint64_t position = req->sgeOffset + completed;
+        uint64_t base = 0;
+        for (uint32_t index = 0; index < req->sgeCount; ++index) {
+            const SgeDesc &sge = req->sgeList[index];
+            if (position < base + sge.len) {
+                uint64_t inSge = position - base;
+                req->lkey = sge.lkey;
+                req->sgeBase = sge.lVaddr;
+                req->vaddr = sge.lVaddr + inSge;
+                req->bytesDone = completed;
+                req->chunkOffset = completed;
+                req->offset = req->vaddr & 0xfff;
+                req->chunkLength = std::min(
+                    std::min(uint64_t(sge.len - inSge), uint64_t(req->length - completed)),
+                    uint64_t(PAGE_SIZE - req->offset));
+                HANGU_PRINT(MrResc, " Continue SGE chunk: index %u, vaddr 0x%lx, offset %u, length %u\n",
+                    index, req->vaddr, req->chunkOffset, req->chunkLength);
+                if (req->type == DMA_TYPE_RRSP) {
+                    req->type = DMA_TYPE_RREQ;
+                }
+                mptReqProcess(req);
+                return true;
+            }
+            base += sge.len;
+        }
+        panic("SGE position out of range: position 0x%lx, count %u\n", position, req->sgeCount);
+    }
+    req->bytesDone += req->chunkLength;
+    if (req->bytesDone >= req->length) {
+        return false;
+    }
+    uint64_t addr = req->vaddr + req->bytesDone;
+    req->offset = addr & 0xfff;
+    req->chunkOffset = req->bytesDone;
+    req->chunkLength = std::min(uint64_t(req->length - req->bytesDone),
+        uint64_t(PAGE_SIZE - req->offset));
+    uint64_t mttIdx = req->mttSeg + ((addr - req->mrStart) >> PAGE_SIZE_LOG);
+    HANGU_PRINT(MrResc, " Continue MR chunk: vaddr 0x%lx, offset %u, length %u\n",
+        addr, req->chunkOffset, req->chunkLength);
+    if (req->type == DMA_TYPE_RRSP) {
+        req->type = DMA_TYPE_RREQ;
+    }
+    mttReqProcess(mttIdx, req);
+    return true;
+}
