+static uint32_t qp_required_mask(enum ibv_qp_state old, enum ibv_qp_state state) {
+    if (state == IBV_QPS_ERR || (old == IBV_QPS_ERR && state == IBV_QPS_RESET) ||
+        (old == IBV_QPS_RTS && state == IBV_QPS_SQD) ||
+        (old == IBV_QPS_SQD && state == IBV_QPS_RTS)) {
+        return IBV_QP_STATE;
+    }
+    if (old == IBV_QPS_RESET && state == IBV_QPS_INIT) {
+        return IBV_QP_STATE | IBV_QP_ACCESS_FLAGS | IBV_QP_PKEY_INDEX | IBV_QP_PORT;
+    }
+    if (old == IBV_QPS_INIT && state == IBV_QPS_RTR) {
+        return IBV_QP_STATE | IBV_QP_PATH_MTU | IBV_QP_DEST_QPN |
+            IBV_QP_RQ_PSN | IBV_QP_MAX_DEST_RD_ATOMIC;
+    }
+    if (old == IBV_QPS_RTR && state == IBV_QPS_RTS) {
+        return IBV_QP_STATE | IBV_QP_SQ_PSN | IBV_QP_TIMEOUT |
+            IBV_QP_RETRY_CNT | IBV_QP_RNR_RETRY | IBV_QP_MAX_QP_RD_ATOMIC;
+    }
+    return UINT32_MAX;
