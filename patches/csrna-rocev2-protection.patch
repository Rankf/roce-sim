+    QP_CHECK("invalid-error-to-init", ibv_modify_qp_state(resc->ctx, qp,
+        IBV_QPS_INIT, init_mask) < 0 && qp->state == IBV_QPS_ERR);
+    QP_CHECK("reset", ibv_modify_qp_state(resc->ctx, qp,
+        IBV_QPS_RESET, IBV_QP_STATE) == 0 && qp->state == IBV_QPS_RESET);
+    QP_CHECK("missing-init-attrs", ibv_modify_qp_state(resc->ctx, qp,
+        IBV_QPS_INIT, IBV_QP_STATE) < 0 && qp->state == IBV_QPS_RESET);
+    QP_CHECK("init", ibv_modify_qp_state(resc->ctx, qp,
+        IBV_QPS_INIT, init_mask) == 0 && qp->state == IBV_QPS_INIT);
+    QP_CHECK("invalid-mask", ibv_modify_qp_state(resc->ctx, qp,
+        IBV_QPS_RTR, rtr_mask | (1U << 30)) < 0 && qp->state == IBV_QPS_INIT);
+    qp->path_mtu = 2048;
+    QP_CHECK("invalid-mtu", ibv_modify_qp_state(resc->ctx, qp,
+        IBV_QPS_RTR, rtr_mask) < 0 && qp->state == IBV_QPS_INIT);
+    qp->path_mtu = 4096;
+    QP_CHECK("rtr", ibv_modify_qp_state(resc->ctx, qp,
+        IBV_QPS_RTR, rtr_mask) == 0 && qp->state == IBV_QPS_RTR);
+    QP_CHECK("rts", ibv_modify_qp_state(resc->ctx, qp,
+        IBV_QPS_RTS, rts_mask) == 0 && qp->state == IBV_QPS_RTS);
+    QP_CHECK("sqd", ibv_modify_qp_state(resc->ctx, qp,
+        IBV_QPS_SQD, IBV_QP_STATE) == 0 && qp->state == IBV_QPS_SQD);
+    QP_CHECK("sqd-resume", ibv_modify_qp_state(resc->ctx, qp,
+        IBV_QPS_RTS, IBV_QP_STATE) == 0 && qp->state == IBV_QPS_RTS);
+    RDMA_PRINT(Server, "QP_LIFECYCLE_SUMMARY passed=%d failed=%d state=%u\n",
+        passed, failed, qp->state);
+    return failed != 0;
+#undef QP_CHECK
+}
