+int atomic_protection_test(struct rdma_resc *resc) {
+    struct ibv_qp *qp = resc->qp[0];
+    int denied = 0;
+    if (atomic_execute(resc, qp, IBV_TYPE_ATOMIC_FAA, 0, 0, 1, 0,
+            0x4159000000000000UL) != IBV_WC_REM_ACCESS_ERR) {
+        return 1;
+    }
+    ++denied;
+    struct ibv_wqe bad_key;
+    atomic_init_wqe(&bad_key, resc, IBV_TYPE_ATOMIC_FAA, 0, 8, 1, 0,
+        0x4159000000000001UL);
+    bad_key.rdma.rkey ^= 0x80000000;
+    if (ibv_post_send(resc->ctx, &bad_key, qp, 1)) {
+        return 1;
+    }
+    if (atomic_wait_wr(resc, qp, IBV_TYPE_ATOMIC_FAA,
+            bad_key.wr_id, 8) != IBV_WC_REM_ACCESS_ERR) {
+        return 1;
+    }
+    ++denied;
+    if (atomic_execute(resc, qp, IBV_TYPE_ATOMIC_FAA, 4096, 16, 1, 0,
+            0x4159000000000002UL) != IBV_WC_REM_ACCESS_ERR) {
+        return 1;
+    }
+    ++denied;
+    struct ibv_wqe misaligned;
+    atomic_init_wqe(&misaligned, resc, IBV_TYPE_ATOMIC_FAA, 1, 24, 1, 0,
+        0x4159000000000003UL);
+    struct ibv_wqe *bad_wr = NULL;
+    int rc = ibv_post_send_ex(resc->ctx, &misaligned, qp, 1, &bad_wr);
+    RDMA_PRINT(Server, "ATOMIC_PROTECT_SUMMARY denied=%u submit_rejected=%d\n",
+        denied, rc ? 1 : 0);
+    return rc == 0 || bad_wr != &misaligned;
+}
