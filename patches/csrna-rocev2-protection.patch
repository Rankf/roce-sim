+void
+HanGuRnic::RdmaEngine::postCnp(std::pair<uint32_t, uint64_t> key) {
+    CnpState &state = cnpStates[key];
+    uint32_t qpn = state.qpn;
+    EthPacketPtr txPkt = std::make_shared<EthPacketData>(16384);
+    RoCEv2::setIpVersion(txPkt->data, rnic->params()->roce_ip_version);
+    txPkt->length = RoCEv2::bthOffset(txPkt->data) + RoCEv2::BthSize + 16;
+    txPkt->simLength = 16;
+    setMacAddr(txPkt->data, state.destLid);
+    setMacAddr(txPkt->data + ETH_ADDR_LEN, state.sourceLid);
+    RoCEv2::writeHeaders(txPkt->data, RoCEv2::BthSize + 16 + RoCEv2::IcrcSize,
+        state.sourceLid, state.destLid, 0);
+    RoCEv2::writeBth(txPkt->data, 0x81, state.destQpn, 0, false);
+    RoCEv2::writeBe16(txPkt->data + RoCEv2::bthOffset(txPkt->data) + 2, state.pkey);
+    memset(txPkt->data + RoCEv2::bthOffset(txPkt->data) + RoCEv2::BthSize, 0, 16);
+    RoCEv2::finishPacket(txPkt->data, txPkt->length);
+    txPkt->length += RoCEv2::IcrcSize;
+    txPkt->simLength += RoCEv2::IcrcSize;
+    queueTxPacket(txPkt, qpn);
+    ++state.generated;
+    HANGU_PRINT(RdmaEngine, " CNP_TX qpn %u dest_qpn %u generation %lu tick %lu\n",
+        qpn, state.destQpn, state.generated, curTick());
+    if (!sauEvent.scheduled()) {
+        rnic->schedule(sauEvent, curTick() + rnic->clockPeriod());
+    }
+}
+
+void
+HanGuRnic::RdmaEngine::armCnpTimer() {
+    Tick next = 0;
+    for (const auto &entry : cnpStates) {
+        if (entry.second.pending && (!next || entry.second.deadline < next)) {
+            next = entry.second.deadline;
+        }
+    }
+    if (next) {
+        if (cnpEvent.scheduled()) {
+            rnic->reschedule(cnpEvent, next, true);
+        } else {
+            rnic->schedule(cnpEvent, next);
+        }
+    } else if (cnpEvent.scheduled()) {
+        rnic->deschedule(cnpEvent);
+    }
+}
+
+void
+HanGuRnic::RdmaEngine::cnpTimer() {
+    for (auto &entry : cnpStates) {
+        CnpState &state = entry.second;
+        if (!state.pending || state.deadline > curTick()) {
+            continue;
+        }
+        if (state.suppressed) {
+            postCnp(entry.first);
+        }
+        state.pending = false;
+        state.suppressed = 0;
+    }
+    armCnpTimer();
+}
+
+void
+HanGuRnic::RdmaEngine::handleCe(EthPacketPtr rxPkt, QpcResc *qpc) {
+    if (!rnic->params()->enable_cnp || RoCEv2::ecn(rxPkt->data) != 3) {
+        return;
+    }
+    uint8_t opcode = RoCEv2::opcode(rxPkt->data);
+    bool dataPacket = opcode == RoCEv2::RcSendFirst ||
+        opcode == RoCEv2::RcSendMiddle || opcode == RoCEv2::RcSendLast ||
+        opcode == RoCEv2::RcSendLastWithImmediate || opcode == RoCEv2::RcSendOnly ||
+        opcode == RoCEv2::RcSendOnlyWithImmediate ||
+        opcode == RoCEv2::RcSendLastWithInvalidate ||
+        opcode == RoCEv2::RcSendOnlyWithInvalidate ||
+        opcode == RoCEv2::RcWriteFirst || opcode == RoCEv2::RcWriteMiddle ||
+        opcode == RoCEv2::RcWriteLast || opcode == RoCEv2::RcWriteOnly ||
+        opcode == RoCEv2::RcWriteOnlyWithImmediate ||
+        opcode == RoCEv2::RcReadResponseFirst ||
+        opcode == RoCEv2::RcReadResponseMiddle ||
+        opcode == RoCEv2::RcReadResponseLast ||
+        opcode == RoCEv2::RcReadResponseOnly ||
+        opcode == RoCEv2::RcAtomicAcknowledge;
+    if (!dataPacket) {
+        return;
+    }
+    uint64_t sourceLid = 0;
+    for (int index = 0; index < ETH_ADDR_LEN; ++index) {
+        sourceLid = (sourceLid << 8) | rxPkt->data[ETH_ADDR_LEN + index];
+    }
+    auto key = std::make_pair(qpc->srcQpn, sourceLid);
+    CnpState &state = cnpStates[key];
+    state.qpn = qpc->srcQpn;
+    ++state.cePackets;
+    HANGU_PRINT(RdmaEngine, " CE_RX qpn %u count %lu tick %lu\n",
+        qpc->srcQpn, state.cePackets, curTick());
+    if (state.pending) {
+        ++state.suppressed;
+        HANGU_PRINT(RdmaEngine, " CNP_MERGE qpn %u suppressed %lu\n",
+            qpc->srcQpn, state.suppressed);
+    } else {
+        state.pending = true;
+        state.deadline = curTick() + rnic->params()->cnp_merge_interval;
+        state.destQpn = qpc->destQpn;
+        state.sourceLid = qpc->lLid;
+        state.destLid = sourceLid;
+        state.pkey = RoCEv2::readBe16(rxPkt->data + RoCEv2::bthOffset(rxPkt->data) + 2);
+        postCnp(key);
+    }
+    armCnpTimer();
+}
+
+void
+HanGuRnic::RdmaEngine::cnpProcessing(EthPacketPtr rxPkt) {
+    uint32_t qpn = RoCEv2::destQpn(rxPkt->data);
+    const uint8_t *reserved = rxPkt->data + RoCEv2::bthOffset(rxPkt->data) +
+        RoCEv2::BthSize;
+    for (int index = 0; index < 16; ++index) {
+        if (reserved[index]) {
+            HANGU_PRINT(RdmaEngine, " CNP_INVALID qpn %u reserved_nonzero\n", qpn);
+            return;
+        }
+    }
+    if (!qpStates.count(qpn)) {
+        HANGU_PRINT(RdmaEngine, " CNP_DROP_UNKNOWN_QP qpn %u\n", qpn);
+        return;
+    }
+    ++cnpReceived[qpn];
+    HANGU_PRINT(RdmaEngine, " CNP_RX qpn %u count %lu tick %lu\n",
+        qpn, cnpReceived[qpn], curTick());
+    if (rnic->params()->enable_dcqcn &&
+            (qpStates[qpn] == IBV_QPS_RTS || qpStates[qpn] == IBV_QPS_SQD)) {
+        DCQCN::State &state = pacerState(qpn);
+        DCQCN::onCnp(state, dcqcnParams(), curTick());
+        logDcqcn("DCQCN_CNP", qpn, state);
+        armDcqcnTimer();
+        armSau();
+    }
+}
