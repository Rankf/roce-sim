+int rc_state_test(struct rdma_resc *resc, uint8_t op_mode, uint32_t requests) {
+    uint8_t expected_type = op_mode == OPMODE_RDMA_WRITE ? IBV_TYPE_RDMA_WRITE : IBV_TYPE_RDMA_READ;
+    uint32_t success = 0, failure = 0;
+    svr_post_send(resc, resc->qp[0], requests, 0, op_mode);
+    while (success + failure < requests) {
+        int res = ibv_poll_cpl(resc->cq[0], resc->desc, MAX_CPL_NUM);
+        for (int i = 0; i < res; ++i) {
+            if (resc->desc[i]->trans_type == expected_type) {
+                if (resc->desc[i]->status) {
+                    ++failure;
+                } else {
+                    ++success;
+                }
+                RDMA_PRINT(Server, "RC_STATE_CQE mode=%u status=%u byte_cnt=%u\n",
+                    protect_mode, resc->desc[i]->status, resc->desc[i]->byte_cnt);
+            }
+        }
+    }
+    RDMA_PRINT(Server, "RC_STATE_SUMMARY mode=%u submitted=%u success=%u failure=%u outstanding=%u\n",
+        protect_mode, requests, success, failure, requests - success - failure);
+    if (protect_mode == 36) {
+        return success != 0 || failure != requests;
+    }
+    return success != requests || failure != 0;
+}
