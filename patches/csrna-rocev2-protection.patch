+void
+HanGuRnic::RdmaEngine::updateQpDrain(uint32_t qpn) {
+    if (sqdWaiting.count(qpn) && isQpDrained(qpn)) {
+        HANGU_PRINT(RdmaEngine, " SQD_DRAINED qpn %u\n", qpn);
+    }
+}
