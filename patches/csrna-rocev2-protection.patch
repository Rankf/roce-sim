diff --git a/src/dev/net/pfc.hh b/src/dev/net/pfc.hh
new file mode 100644
index 0000000..7d59cd5
--- /dev/null
+++ b/src/dev/net/pfc.hh
@@ -0,0 +1,92 @@
+#ifndef __DEV_NET_PFC_HH__
+#define __DEV_NET_PFC_HH__
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace PFC {
+
+constexpr uint16_t MacControlEtherType = 0x8808;
+constexpr uint16_t MacControlOpcode = 0x0101;
+constexpr std::size_t FrameSize = 60;
+constexpr uint8_t PriorityCount = 8;
+
+inline uint16_t read16(const uint8_t *p) {
+    return (uint16_t(p[0]) << 8) | p[1];
+}
+
+inline void write16(uint8_t *p, uint16_t value) {
+    p[0] = value >> 8;
+    p[1] = value;
+}
+
+inline uint8_t dscp(const uint8_t *packet) {
+    uint16_t type = read16(packet + 12);
+    if (type == 0x0800) {
+        return packet[15] >> 2;
+    }
+    if (type == 0x86dd) {
+        uint16_t trafficClass = ((packet[14] & 0x0f) << 4) | (packet[15] >> 4);
+        return trafficClass >> 2;
+    }
+    return 0;
+}
+
+inline uint8_t priority(uint8_t value) {
+    return (value >> 3) & 7;
+}
+
+inline bool isPfc(const uint8_t *packet, std::size_t length) {
+    static const uint8_t destination[6] = {0x01, 0x80, 0xc2, 0, 0, 1};
+    return length >= 34 && std::memcmp(packet, destination, 6) == 0 &&
+        read16(packet + 12) == MacControlEtherType &&
+        read16(packet + 14) == MacControlOpcode;
+}
+
+inline uint16_t enableVector(const uint8_t *packet) {
+    return read16(packet + 16) & 0xff;
+}
+
+inline uint16_t pauseTime(const uint8_t *packet, uint8_t priority) {
+    return read16(packet + 18 + 2 * priority);
+}
+
+inline uint64_t pauseTicks(uint16_t quantum, double lineTicksPerByte) {
+    return uint64_t(std::ceil(uint64_t(quantum) * 64.0 * lineTicksPerByte));
+}
+
+inline void apply(const uint8_t *packet, std::array<uint64_t, 8> &pauseUntil,
+        uint64_t now, double lineTicksPerByte) {
+    uint16_t enable = enableVector(packet);
+    for (uint8_t index = 0; index < PriorityCount; ++index) {
+        if (!(enable & (1U << index))) {
+            continue;
+        }
+        uint16_t quantum = pauseTime(packet, index);
+        pauseUntil[index] = quantum ? now + pauseTicks(quantum, lineTicksPerByte) : 0;
+    }
+}
+
+inline void writeFrame(uint8_t *packet, uint64_t sourceMac, uint16_t enable,
+        const std::array<uint16_t, 8> &times) {
+    static const uint8_t destination[6] = {0x01, 0x80, 0xc2, 0, 0, 1};
+    std::memset(packet, 0, FrameSize);
+    std::memcpy(packet, destination, 6);
+    for (int index = 0; index < 6; ++index) {
+        packet[6 + index] = sourceMac >> ((5 - index) * 8);
+    }
+    write16(packet + 12, MacControlEtherType);
+    write16(packet + 14, MacControlOpcode);
+    write16(packet + 16, enable & 0xff);
+    for (uint8_t index = 0; index < PriorityCount; ++index) {
+        write16(packet + 18 + 2 * index, times[index]);
+    }
+}
+
+} // namespace PFC
+
+#endif
diff --git a/src/dev/rdma/dcqcn.hh b/src/dev/rdma/dcqcn.hh
new file mode 100644
index 0000000..a081759
--- /dev/null
+++ b/src/dev/rdma/dcqcn.hh
@@ -0,0 +1,233 @@
+#ifndef __RDMA_DCQCN_HH__
+#define __RDMA_DCQCN_HH__
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+namespace DCQCN {
+
+struct Params {
+    uint64_t maxRate = 100000000000ULL;
+    uint64_t minRate = 100000000ULL;
+    uint64_t rateAI = 5000000ULL;
+    uint64_t rateHAI = 50000000ULL;
+    double rateOnFirstCnp = 1.0;
+    double alphaGain = 1.0 / 16;
+    bool clampTargetRate = false;
+    uint64_t alphaInterval = 55000000;
+    uint64_t decreaseInterval = 4000000;
+    uint64_t recoveryInterval = 1500000000;
+    uint32_t fastRecoveryTimes = 5;
+    bool dualTrigger = false;
+    uint64_t byteRecoveryBytes = 10000000;
+};
+
+struct State {
+    uint64_t currentRate = 0;
+    uint64_t targetRate = 0;
+    double alpha = 1.0;
+    bool firstCnp = true;
+    bool alphaCnpArrived = false;
+    bool decreaseCnpArrived = false;
+    bool alphaActive = false;
+    bool decreaseActive = false;
+    bool recoveryActive = false;
+    uint64_t alphaDeadline = 0;
+    uint64_t decreaseDeadline = 0;
+    uint64_t recoveryDeadline = 0;
+    uint32_t recoveryStage = 0;
+    uint32_t recoveryPhase = 0;
+    uint64_t timeRecoveryCount = 0;
+    uint64_t byteRecoveryCount = 0;
+    uint64_t byteRemainder = 0;
+    uint64_t nextSend = 0;
+    uint32_t lastPacketSize = 0;
+    uint64_t cnpCount = 0;
+    uint64_t decreaseCount = 0;
+};
+
+inline uint64_t
+packetTicks(uint32_t bytes, uint64_t rate)
+{
+    const uint64_t numerator = uint64_t(bytes) * 8ULL * 1000000000000ULL;
+    return std::max<uint64_t>(1, numerator / rate + (numerator % rate != 0));
+}
+
+inline void
+changeRate(State &state, uint64_t newRate, uint64_t now)
+{
+    newRate = std::max<uint64_t>(1, newRate);
+    if (state.lastPacketSize && state.currentRate && state.nextSend) {
+        uint64_t oldDelay = packetTicks(state.lastPacketSize, state.currentRate);
+        uint64_t newDelay = packetTicks(state.lastPacketSize, newRate);
+        if (newDelay >= oldDelay) {
+            state.nextSend += newDelay - oldDelay;
+        } else {
+            state.nextSend -= std::min(state.nextSend, oldDelay - newDelay);
+        }
+    }
+    state.currentRate = newRate;
+    (void)now;
+}
+
+inline void
+initialize(State &state, const Params &params, uint64_t rate = 0)
+{
+    state = State();
+    state.currentRate = rate ? rate : params.maxRate;
+    state.targetRate = state.currentRate;
+}
+
+inline void
+onCnp(State &state, const Params &params, uint64_t now)
+{
+    ++state.cnpCount;
+    state.alphaCnpArrived = true;
+    state.decreaseCnpArrived = true;
+    if (state.firstCnp) {
+        state.alpha = 1.0;
+        state.alphaCnpArrived = false;
+        state.alphaActive = true;
+        state.decreaseActive = true;
+        state.alphaDeadline = now + params.alphaInterval;
+        state.decreaseDeadline = now + params.decreaseInterval + 1000;
+        uint64_t initialRate = state.currentRate * params.rateOnFirstCnp;
+        changeRate(state, initialRate, now);
+        state.targetRate = state.currentRate;
+        state.firstCnp = false;
+    }
+}
+
+inline void
+updateAlpha(State &state, const Params &params, uint64_t now)
+{
+    if (!state.alphaActive) {
+        return;
+    }
+    state.alpha = (1.0 - params.alphaGain) * state.alpha +
+        (state.alphaCnpArrived ? params.alphaGain : 0.0);
+    state.alphaCnpArrived = false;
+    state.alphaDeadline = now + params.alphaInterval;
+}
+
+inline bool
+checkRateDecrease(State &state, const Params &params, uint64_t now)
+{
+    if (!state.decreaseActive) {
+        return false;
+    }
+    state.decreaseDeadline = now + params.decreaseInterval;
+    if (!state.decreaseCnpArrived) {
+        return false;
+    }
+    bool clamp = params.clampTargetRate || state.recoveryStage != 0;
+    if (clamp) {
+        state.targetRate = state.currentRate;
+    }
+    changeRate(state, std::max(params.minRate,
+        uint64_t(state.currentRate * (1.0 - state.alpha / 2.0))), now);
+    ++state.decreaseCount;
+    state.recoveryStage = 0;
+    state.timeRecoveryCount = 0;
+    state.byteRecoveryCount = 0;
+    state.byteRemainder = 0;
+    state.decreaseCnpArrived = false;
+    state.recoveryActive = true;
+    state.recoveryDeadline = now + params.recoveryInterval;
+    return true;
+}
+
+enum RecoveryTrigger {
+    TIME_TRIGGER,
+    BYTE_TRIGGER
+};
+
+inline uint32_t
+increaseRate(State &state, const Params &params, uint64_t now,
+        RecoveryTrigger trigger = TIME_TRIGGER)
+{
+    if (!state.recoveryActive) {
+        return UINT32_MAX;
+    }
+    uint32_t stage = state.recoveryStage;
+    if (params.dualTrigger) {
+        if (trigger == TIME_TRIGGER) {
+            ++state.timeRecoveryCount;
+        } else {
+            ++state.byteRecoveryCount;
+        }
+        if (std::max(state.timeRecoveryCount, state.byteRecoveryCount) <
+                params.fastRecoveryTimes) {
+            state.recoveryPhase = 0;
+        } else if (std::min(state.timeRecoveryCount, state.byteRecoveryCount) >
+                params.fastRecoveryTimes) {
+            state.recoveryPhase = 2;
+        } else {
+            state.recoveryPhase = 1;
+        }
+    } else {
+        state.recoveryPhase = stage < params.fastRecoveryTimes ? 0 :
+            (stage == params.fastRecoveryTimes ? 1 : 2);
+    }
+    if (state.recoveryPhase == 0) {
+        changeRate(state, state.currentRate / 2 + state.targetRate / 2, now);
+    } else {
+        state.targetRate = std::min(params.maxRate, state.targetRate +
+            (state.recoveryPhase == 1 ? params.rateAI : params.rateHAI));
+        changeRate(state, state.currentRate / 2 + state.targetRate / 2, now);
+    }
+    ++state.recoveryStage;
+    if (!params.dualTrigger || trigger == TIME_TRIGGER) {
+        state.recoveryDeadline = now + params.recoveryInterval;
+    }
+    return stage;
+}
+
+inline uint32_t
+onSentBytes(State &state, const Params &params, uint32_t bytes, uint64_t now)
+{
+    if (!params.dualTrigger || !state.recoveryActive || !params.byteRecoveryBytes) {
+        return 0;
+    }
+    state.byteRemainder += bytes;
+    uint32_t triggers = 0;
+    while (state.byteRemainder >= params.byteRecoveryBytes) {
+        state.byteRemainder -= params.byteRecoveryBytes;
+        increaseRate(state, params, now, BYTE_TRIGGER);
+        ++triggers;
+    }
+    return triggers;
+}
+
+struct ScheduleEntry {
+    uint64_t sequence;
+    bool control;
+    bool eligible;
+};
+
+inline size_t
+selectEntry(const std::vector<ScheduleEntry> &entries, uint64_t cursor)
+{
+    for (size_t index = 0; index < entries.size(); ++index) {
+        if (entries[index].control && entries[index].eligible) {
+            return index;
+        }
+    }
+    for (int wrap = 0; wrap < 2; ++wrap) {
+        for (size_t index = 0; index < entries.size(); ++index) {
+            bool afterCursor = entries[index].sequence >= cursor;
+            if ((wrap == 0) != afterCursor) {
+                continue;
+            }
+            if (entries[index].eligible) {
+                return index;
+            }
+        }
+    }
+    return entries.size();
+}
+
+} // namespace DCQCN
+
+#endif
diff --git a/src/dev/rdma/rocev2.hh b/src/dev/rdma/rocev2.hh
new file mode 100644
index 0000000..828ac3f
--- /dev/null
+++ b/src/dev/rdma/rocev2.hh
@@ -0,0 +1,428 @@
+#ifndef __ROCEV2_HH__
+#define __ROCEV2_HH__
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace RoCEv2 {
+
+constexpr std::size_t EthHeaderSize = 14;
+constexpr std::size_t Ipv4HeaderSize = 20;
+constexpr std::size_t Ipv6HeaderSize = 40;
+constexpr std::size_t UdpHeaderSize = 8;
+constexpr std::size_t BthSize = 12;
+constexpr std::size_t RethSize = 16;
+constexpr std::size_t AtomicEthSize = 28;
+constexpr std::size_t AtomicAckEthSize = 8;
+constexpr std::size_t AethSize = 4;
+constexpr std::size_t IethSize = 4;
+constexpr std::size_t ImmediateSize = 4;
+constexpr std::size_t DethSize = 8;
+constexpr std::size_t IcrcSize = 4;
+constexpr std::size_t Ipv4Offset = EthHeaderSize;
+constexpr std::size_t UdpOffset = Ipv4Offset + Ipv4HeaderSize;
+constexpr std::size_t BthOffset = UdpOffset + UdpHeaderSize;
+constexpr uint16_t EtherTypeIpv4 = 0x0800;
+constexpr uint16_t EtherTypeIpv6 = 0x86dd;
+constexpr uint16_t UdpDestinationPort = 4791;
+constexpr uint16_t DefaultPKey = 0xffff;
+
+constexpr uint8_t RcSendFirst = 0x00;
+constexpr uint8_t RcSendMiddle = 0x01;
+constexpr uint8_t RcSendLast = 0x02;
+constexpr uint8_t RcSendLastWithImmediate = 0x03;
+constexpr uint8_t RcSendOnly = 0x04;
+constexpr uint8_t RcSendOnlyWithImmediate = 0x05;
+constexpr uint8_t RcWriteFirst = 0x06;
+constexpr uint8_t RcWriteMiddle = 0x07;
+constexpr uint8_t RcWriteLast = 0x08;
+constexpr uint8_t RcWriteOnly = 0x0a;
+constexpr uint8_t RcWriteOnlyWithImmediate = 0x0b;
+constexpr uint8_t RcReadRequest = 0x0c;
+constexpr uint8_t RcReadResponseFirst = 0x0d;
+constexpr uint8_t RcReadResponseMiddle = 0x0e;
+constexpr uint8_t RcReadResponseLast = 0x0f;
+constexpr uint8_t RcReadResponseOnly = 0x10;
+constexpr uint8_t RcAcknowledge = 0x11;
+constexpr uint8_t RcAtomicAcknowledge = 0x12;
+constexpr uint8_t RcCompareSwap = 0x13;
+constexpr uint8_t RcFetchAdd = 0x14;
+constexpr uint8_t RcSendLastWithInvalidate = 0x16;
+constexpr uint8_t RcSendOnlyWithInvalidate = 0x17;
+constexpr uint8_t UdSendOnly = 0x64;
+
+struct __attribute__((packed)) Bth {
+    uint8_t opcode;
+    uint8_t flags;
+    uint16_t pkey;
+    uint32_t destQpn;
+    uint32_t psn;
+};
+
+struct __attribute__((packed)) Reth {
+    uint64_t addr;
+    uint32_t key;
+    uint32_t length;
+};
+
+struct __attribute__((packed)) AtomicEth {
+    uint64_t addr;
+    uint32_t key;
+    uint64_t swapOrAdd;
+    uint64_t compare;
+};
+
+struct __attribute__((packed)) AtomicAckEth {
+    uint64_t original;
+};
+
+struct __attribute__((packed)) Aeth {
+    uint32_t syndromeMsn;
+};
+
+struct __attribute__((packed)) Deth {
+    uint32_t qkey;
+    uint32_t srcQpn;
+};
+
+inline uint16_t readBe16(const uint8_t *p) {
+    return (uint16_t(p[0]) << 8) | uint16_t(p[1]);
+}
+
+inline uint32_t readBe32(const uint8_t *p) {
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) |
+        (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+}
+
+inline uint64_t readBe64(const uint8_t *p) {
+    return (uint64_t(readBe32(p)) << 32) | uint64_t(readBe32(p + 4));
+}
+
+inline void writeBe16(uint8_t *p, uint16_t value) {
+    p[0] = value >> 8;
+    p[1] = value;
+}
+
+inline void writeBe32(uint8_t *p, uint32_t value) {
+    p[0] = value >> 24;
+    p[1] = value >> 16;
+    p[2] = value >> 8;
+    p[3] = value;
+}
+
+inline void writeBe64(uint8_t *p, uint64_t value) {
+    writeBe32(p, value >> 32);
+    writeBe32(p + 4, value);
+}
+
+inline std::size_t bthOffset(const uint8_t *packet) {
+    return readBe16(packet + 12) == EtherTypeIpv6 ?
+        EthHeaderSize + Ipv6HeaderSize + UdpHeaderSize : BthOffset;
+}
+
+inline std::size_t udpOffset(const uint8_t *packet) {
+    return bthOffset(packet) - UdpHeaderSize;
+}
+
+inline void setIpVersion(uint8_t *packet, uint8_t version) {
+    writeBe16(packet + 12, version == 6 ? EtherTypeIpv6 : EtherTypeIpv4);
+}
+
+inline const Bth *bth(const uint8_t *packet) {
+    return reinterpret_cast<const Bth *>(packet + bthOffset(packet));
+}
+
+inline Bth *bth(uint8_t *packet) {
+    return reinterpret_cast<Bth *>(packet + bthOffset(packet));
+}
+
+inline uint8_t opcode(const uint8_t *packet) {
+    return packet[bthOffset(packet)];
+}
+
+inline uint32_t destQpn(const uint8_t *packet) {
+    return readBe32(packet + bthOffset(packet) + 4) & 0x00ffffff;
+}
+
+inline uint32_t psn(const uint8_t *packet) {
+    return readBe32(packet + bthOffset(packet) + 8) & 0x00ffffff;
+}
+
+constexpr uint32_t PsnMask = 0x00ffffff;
+constexpr uint32_t PsnSignBit = 0x00800000;
+constexpr uint32_t PsnModulus = 0x01000000;
+
+inline uint32_t psnAdd(uint32_t value, uint32_t count) {
+    return (value + count) & PsnMask;
+}
+
+inline int32_t psnCompare(uint32_t left, uint32_t right) {
+    uint32_t difference = (left - right) & PsnMask;
+    return difference & PsnSignBit ? int32_t(difference - PsnModulus) :
+        int32_t(difference);
+}
+
+inline bool psnLess(uint32_t left, uint32_t right) {
+    return psnCompare(left, right) < 0;
+}
+
+inline void writeBth(uint8_t *packet, uint8_t op, uint32_t destination,
+        uint32_t sequence, bool acknowledge = true) {
+    Bth *value = bth(packet);
+    value->opcode = op;
+    value->flags = 0;
+    writeBe16(reinterpret_cast<uint8_t *>(&value->pkey), DefaultPKey);
+    writeBe32(reinterpret_cast<uint8_t *>(&value->destQpn), destination & 0x00ffffff);
+    writeBe32(reinterpret_cast<uint8_t *>(&value->psn),
+        (sequence & 0x00ffffff) | (acknowledge ? 0x80000000 : 0));
+}
+
+inline void writeReth(uint8_t *packet, uint64_t addr, uint32_t key, uint32_t length) {
+    Reth *value = reinterpret_cast<Reth *>(packet + bthOffset(packet) + BthSize);
+    writeBe64(reinterpret_cast<uint8_t *>(&value->addr), addr);
+    writeBe32(reinterpret_cast<uint8_t *>(&value->key), key);
+    writeBe32(reinterpret_cast<uint8_t *>(&value->length), length);
+}
+
+inline uint64_t rethAddr(const uint8_t *packet) {
+    return readBe64(packet + bthOffset(packet) + BthSize);
+}
+
+inline uint32_t rethKey(const uint8_t *packet) {
+    return readBe32(packet + bthOffset(packet) + BthSize + 8);
+}
+
+inline uint32_t rethLength(const uint8_t *packet) {
+    return readBe32(packet + bthOffset(packet) + BthSize + 12);
+}
+
+inline void writeAtomicEth(uint8_t *packet, uint64_t addr, uint32_t key,
+        uint64_t swapOrAdd, uint64_t compare) {
+    AtomicEth *value = reinterpret_cast<AtomicEth *>(packet + bthOffset(packet) + BthSize);
+    writeBe64(reinterpret_cast<uint8_t *>(&value->addr), addr);
+    writeBe32(reinterpret_cast<uint8_t *>(&value->key), key);
+    writeBe64(reinterpret_cast<uint8_t *>(&value->swapOrAdd), swapOrAdd);
+    writeBe64(reinterpret_cast<uint8_t *>(&value->compare), compare);
+}
+
+inline uint64_t atomicAddr(const uint8_t *packet) {
+    return readBe64(packet + bthOffset(packet) + BthSize);
+}
+
+inline uint32_t atomicKey(const uint8_t *packet) {
+    return readBe32(packet + bthOffset(packet) + BthSize + 8);
+}
+
+inline uint64_t atomicSwapOrAdd(const uint8_t *packet) {
+    return readBe64(packet + bthOffset(packet) + BthSize + 12);
+}
+
+inline uint64_t atomicCompare(const uint8_t *packet) {
+    return readBe64(packet + bthOffset(packet) + BthSize + 20);
+}
+
+inline void writeAtomicOriginal(uint8_t *packet, uint64_t original) {
+    writeBe64(packet + bthOffset(packet) + BthSize, original);
+}
+
+inline uint64_t atomicOriginal(const uint8_t *packet) {
+    return readBe64(packet + bthOffset(packet) + BthSize);
+}
+
+inline void writeIeth(uint8_t *packet, uint32_t rkey) {
+    writeBe32(packet + bthOffset(packet) + BthSize, rkey);
+}
+
+inline uint32_t iethRkey(const uint8_t *packet) {
+    return readBe32(packet + bthOffset(packet) + BthSize);
+}
+
+inline void writeImmediate(uint8_t *packet, std::size_t transportOffset,
+        uint32_t value) {
+    writeBe32(packet + bthOffset(packet) + BthSize + transportOffset, value);
+}
+
+inline uint32_t immediate(const uint8_t *packet, std::size_t transportOffset) {
+    return readBe32(packet + bthOffset(packet) + BthSize + transportOffset);
+}
+
+inline void writeAeth(uint8_t *packet, uint8_t syndrome, uint8_t credit = 0) {
+    writeBe32(packet + bthOffset(packet) + BthSize,
+        (uint32_t(syndrome) << 24) | (uint32_t(credit & 0x1f) << 16));
+}
+
+inline uint8_t aethSyndrome(const uint8_t *packet) {
+    return readBe32(packet + bthOffset(packet) + BthSize) >> 24;
+}
+
+inline uint8_t aethCredit(const uint8_t *packet) {
+    return (readBe32(packet + bthOffset(packet) + BthSize) >> 16) & 0x1f;
+}
+
+inline void writeDeth(uint8_t *packet, uint32_t qkey, uint32_t sourceQpn) {
+    writeBe32(packet + bthOffset(packet) + BthSize, qkey);
+    writeBe32(packet + bthOffset(packet) + BthSize + 4, sourceQpn & 0x00ffffff);
+}
+
+inline uint32_t ipv4Checksum(const uint8_t *header) {
+    uint32_t sum = 0;
+    for (std::size_t i = 0; i < Ipv4HeaderSize; i += 2) {
+        sum += readBe16(header + i);
+    }
+    while (sum >> 16) {
+        sum = (sum & 0xffff) + (sum >> 16);
+    }
+    return ~sum & 0xffff;
+}
+
+inline uint32_t udpChecksum(const uint8_t *packet, std::size_t length) {
+    std::size_t udp = udpOffset(packet);
+    uint32_t sum = 17 + readBe16(packet + udp + 4);
+    for (std::size_t i = Ipv4Offset + 8; i < Ipv4Offset + 40; i += 2) {
+        sum += readBe16(packet + i);
+    }
+    for (std::size_t i = udp; i + 1 < length; i += 2) {
+        sum += readBe16(packet + i);
+    }
+    while (sum >> 16) {
+        sum = (sum & 0xffff) + (sum >> 16);
+    }
+    return ~sum & 0xffff;
+}
+
+inline void writeHeaders(uint8_t *packet, std::size_t fromBthLength,
+        uint16_t sourceLid, uint16_t destinationLid, uint8_t dscp = 24) {
+    bool ipv6 = readBe16(packet + 12) == EtherTypeIpv6;
+    if (!ipv6) {
+        writeBe16(packet + 12, EtherTypeIpv4);
+    }
+    std::size_t ipSize = ipv6 ? Ipv6HeaderSize : Ipv4HeaderSize;
+    std::size_t udp = udpOffset(packet);
+    uint8_t *ip = packet + Ipv4Offset;
+    std::memset(ip, 0, ipSize);
+    if (ipv6) {
+        writeBe32(ip, 0x60000000);
+        writeBe16(ip + 4, UdpHeaderSize + fromBthLength);
+        uint8_t trafficClass = (dscp << 2) | 2;
+        ip[0] = (ip[0] & 0xf0) | (trafficClass >> 4);
+        ip[1] = (trafficClass << 4) & 0xf0;
+        ip[6] = 17;
+        ip[7] = 64;
+        writeBe64(ip + 8, 0xfd00000000000000UL);
+        writeBe64(ip + 16, sourceLid);
+        writeBe64(ip + 24, 0xfd00000000000000UL);
+        writeBe64(ip + 32, destinationLid);
+    } else {
+        ip[0] = 0x45;
+        writeBe16(ip + 2, Ipv4HeaderSize + UdpHeaderSize + fromBthLength);
+        ip[1] = (dscp << 2) | 2;
+        ip[8] = 64;
+        ip[9] = 17;
+        writeBe32(ip + 12, 0x0a000000 | (sourceLid & 0xff));
+        writeBe32(ip + 16, 0x0a000000 | (destinationLid & 0xff));
+        writeBe16(ip + 10, ipv4Checksum(ip));
+    }
+    writeBe16(packet + udp, 49152);
+    writeBe16(packet + udp + 2, UdpDestinationPort);
+    writeBe16(packet + udp + 4, UdpHeaderSize + fromBthLength);
+    writeBe16(packet + udp + 6, 0);
+}
+
+enum EcnAction : uint8_t {
+    ECN_BELOW_THRESHOLD = 0,
+    ECN_NOT_ECT,
+    ECN_MARKED,
+    ECN_ALREADY_MARKED
+};
+
+inline uint8_t ecn(const uint8_t *packet) {
+    bool ipv6 = readBe16(packet + 12) == EtherTypeIpv6;
+    return ipv6 ? (packet[Ipv4Offset + 1] >> 4) & 3 :
+        packet[Ipv4Offset + 1] & 3;
+}
+
+inline EcnAction applyEcn(uint8_t *packet, std::size_t queueBytes,
+        std::size_t threshold) {
+    uint8_t current = ecn(packet);
+    if (current == 3) {
+        return ECN_ALREADY_MARKED;
+    }
+    if (current == 0) {
+        return ECN_NOT_ECT;
+    }
+    if (queueBytes < threshold) {
+        return ECN_BELOW_THRESHOLD;
+    }
+    bool ipv6 = readBe16(packet + 12) == EtherTypeIpv6;
+    uint8_t *ip = packet + Ipv4Offset;
+    if (ipv6) {
+        ip[1] = (ip[1] & 0xcf) | 0x30;
+    } else {
+        ip[1] |= 3;
+        writeBe16(ip + 10, ipv4Checksum(ip));
+    }
+    return ECN_MARKED;
+}
+
+inline uint32_t icrc(const uint8_t *packet, std::size_t lengthWithoutIcrc) {
+    bool ipv6 = readBe16(packet + 12) == EtherTypeIpv6;
+    std::size_t udp = udpOffset(packet);
+    uint32_t crc = 0xffffffff;
+    for (std::size_t i = Ipv4Offset; i < lengthWithoutIcrc; ++i) {
+        uint8_t byte = packet[i];
+        if ((!ipv6 && (i == Ipv4Offset + 1 || i == Ipv4Offset + 8 ||
+                i == Ipv4Offset + 10 || i == Ipv4Offset + 11)) ||
+                (ipv6 && i >= Ipv4Offset + 1 && i <= Ipv4Offset + 4) ||
+                (ipv6 && i == Ipv4Offset + 7) || i == udp + 6 || i == udp + 7) {
+            byte = 0xff;
+        }
+        crc ^= byte;
+        for (int bit = 0; bit < 8; ++bit) {
+            crc = (crc >> 1) ^ ((crc & 1) ? 0xedb88320 : 0);
+        }
+    }
+    return ~crc;
+}
+
+inline void finishPacket(uint8_t *packet, std::size_t lengthWithoutIcrc) {
+    writeBe32(packet + lengthWithoutIcrc, icrc(packet, lengthWithoutIcrc));
+    if (readBe16(packet + 12) == EtherTypeIpv6) {
+        uint16_t checksum = udpChecksum(packet, lengthWithoutIcrc + IcrcSize);
+        writeBe16(packet + udpOffset(packet) + 6, checksum ? checksum : 0xffff);
+    }
+}
+
+inline bool validPacket(const uint8_t *packet, std::size_t length) {
+    std::size_t bth = bthOffset(packet);
+    if (length < bth + BthSize + IcrcSize) {
+        return false;
+    }
+    uint16_t etherType = readBe16(packet + 12);
+    std::size_t udp = udpOffset(packet);
+    if (etherType == EtherTypeIpv4) {
+        if (packet[Ipv4Offset] != 0x45 || packet[Ipv4Offset + 9] != 17 ||
+                readBe16(packet + Ipv4Offset + 2) != length - Ipv4Offset) {
+            return false;
+        }
+    } else if (etherType == EtherTypeIpv6) {
+        if ((packet[Ipv4Offset] >> 4) != 6 || packet[Ipv4Offset + 6] != 17 ||
+                readBe16(packet + Ipv4Offset + 4) !=
+                    length - Ipv4Offset - Ipv6HeaderSize ||
+                (readBe16(packet + udp + 6) != 0 &&
+                    udpChecksum(packet, length) != 0)) {
+            return false;
+        }
+    } else {
+        return false;
+    }
+    if (readBe16(packet + udp + 2) != UdpDestinationPort ||
+            readBe16(packet + udp + 4) != length - udp) {
+        return false;
+    }
+    return readBe32(packet + length - IcrcSize) == icrc(packet, length - IcrcSize);
+}
+
+}
