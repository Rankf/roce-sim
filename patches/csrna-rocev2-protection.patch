+int ring_stress_test(struct rdma_resc *resc) {
+    const uint32_t count = fixed_wr_num ? fixed_wr_num : 320;
+    for (uint32_t i = 0; i < resc->mr[0]->length; ++i) {
+        resc->mr[0]->addr[i] = (i * 37 + 11) & 0xff;
+    }
+    resc->qp[0]->sq_depth = 4;
+    resc->qp[1]->sq_depth = 4;
+    uint32_t completions = 0;
+    struct ibv_wqe initial[5];
+    for (uint32_t i = 0; i < 5; ++i) {
+        ring_init_wqe(&initial[i], resc, i);
+    }
+    struct ibv_wqe *bad_wr = NULL;
+    int rc = ibv_post_send_ex(resc->ctx, initial, resc->qp[0], 5, &bad_wr);
+    RDMA_PRINT(Server, "RING_PARTIAL accepted=4 rejected=%d bad_index=%ld\n",
+        rc ? 1 : 0, bad_wr ? bad_wr - initial : 5L);
+    if (!rc || bad_wr != &initial[4]) {
+        return 1;
+    }
+    uint32_t posted = 4;
+    while (posted < count) {
+        struct ibv_qp *qp = resc->qp[posted % 2];
+        struct ibv_wqe wqe;
+        ring_init_wqe(&wqe, resc, posted);
+        while (ibv_post_send(resc->ctx, &wqe, qp, 1)) {
+            if (ring_poll(resc, &completions)) {
+                return 1;
+            }
+        }
+        ++posted;
+        if (qp->snd_wqe_offset == 0) {
+            RDMA_PRINT(Server, "RING_WRAP qpn=%u posts=%u\n", qp->qp_num, posted);
+        }
+        if (ring_poll(resc, &completions)) {
+            return 1;
+        }
+    }
+    while (completions < count / 4 + 1) {
+        if (ring_poll(resc, &completions)) {
+            return 1;
+        }
+    }
+    uint32_t outstanding = resc->qp[0]->sq_outstanding + resc->qp[1]->sq_outstanding;
+    RDMA_PRINT(Server, "RING_SUMMARY submitted=%u completions=%u outstanding=%u\n",
+        posted, completions, outstanding);
+    return posted != count || completions != count / 4 + 1 || outstanding;
+}
