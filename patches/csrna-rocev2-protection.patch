+            TxDescPtr previous;
+            while (!window->second->list->empty()) {
+                TxDescPtr desc = window->second->list->front()->txDesc;
+                if (desc != previous) {
+                    postTxCpl(QP_TYPE_RC, qpn, window->second->cqn, desc, IBV_WC_WR_FLUSH_ERR);
+                    previous = desc;
+                }
+                window->second->list->pop_front();
+                --windowSize;
+            }
+            window->second->retransDeadline = 0;
+            window->second->rnrDeadline = 0;
+        }
+    } else if (state == IBV_QPS_RESET) {
+        failedQps.erase(qpn);
+        if (window != sndWindowList.end() && window->second->list) {
+            windowSize -= window->second->list->size();
+            window->second->list->clear();
+            window->second->retryCount = 0;
+            window->second->retransDeadline = 0;
+            window->second->rnrCount = 0;
+            window->second->rnrDeadline = 0;
+            window->second->recovering = false;
+        }
+        remoteWriteAddr.erase(qpn);
+        remoteWriteRemaining.erase(qpn);
+        remoteWriteKey.erase(qpn);
+        remoteReceiveDesc.erase(qpn);
+        remoteReceiveAddr.erase(qpn);
+        remoteReceiveRemaining.erase(qpn);
+        remoteReceiveBytes.erase(qpn);
+        readLocalPending.erase(qpn);
+        txCompletionPending.erase(qpn);
+        readOutstanding.erase(qpn);
+        readFencePending.erase(qpn);
+        destReadOutstanding.erase(qpn);
+        readCreditWait.erase(qpn);
+        atomicResponses.erase(qpn);
+        for (auto state = cnpStates.begin(); state != cnpStates.end();) {
+            if (state->second.qpn == qpn) {
+                state = cnpStates.erase(state);
+            } else {
+                ++state;
+            }
+        }
