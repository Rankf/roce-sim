+int mw_timing_test(struct rdma_resc *resc) {
+    struct ibv_mw *mw = ibv_alloc_mw(resc->ctx, 1);
+    struct ibv_wqe wqe[4];
+    if (mw_bind(resc, resc->qp[0], mw, 0, 512, MR_FLAG_RD | MR_FLAG_WR |
+            MR_FLAG_ATOMIC, 0x4d57000000000050UL)) {
+        return 1;
+    }
+    for (uint32_t i = 0; i < 4; ++i) {
+        atomic_init_wqe(&wqe[i], resc, IBV_TYPE_ATOMIC_FAA, 0, i * 8, 1, 0,
+            0x4d57000000000051UL + i);
+        wqe[i].rdma.rkey = mw->rkey;
+    }
+    if (ibv_post_send(resc->ctx, wqe, resc->qp[0], 4)) {
+        return 1;
+    }
+    for (uint32_t i = 0; i < 4; ++i) {
+        if (atomic_wait_wr(resc, resc->qp[0], IBV_TYPE_ATOMIC_FAA,
+                wqe[i].wr_id, i * 8)) {
+            return 1;
+        }
+    }
+    if (mw_local_inv(resc, resc->qp[0], mw, 0x4d57000000000052UL) ||
+        rdma_recv_sync(resc)) {
+        return 1;
+    }
+    if (mw_rdma(resc, resc->qp[0], IBV_TYPE_RDMA_READ, mw->rkey, 0, 64,
+            0x4d57000000000053UL) != IBV_WC_REM_ACCESS_ERR) {
+        return 1;
+    }
+    mw->rkey = 0x104;
+    if (mw_bind(resc, resc->qp[0], mw, 0, 512, MR_FLAG_RD,
+            0x4d57000000000054UL) || rdma_recv_sync(resc) ||
+        mw_rdma(resc, resc->qp[0], IBV_TYPE_RDMA_READ, mw->rkey, 0, 64,
+            0x4d57000000000055UL)) {
+        return 1;
+    }
+    RDMA_PRINT(Server, "MW06_SUMMARY retired_rebound=1\n");
+    ibv_dealloc_mw(resc->ctx, mw);
+    return 0;
