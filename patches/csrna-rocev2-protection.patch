+bool
+HanGuRnic::RdmaEngine::receivePfc(EthPacketPtr packet) {
+    if (!rnic->params()->enable_pfc || !PFC::isPfc(packet->data, packet->length)) {
+        return false;
+    }
+    expirePfc();
+    uint16_t enable = PFC::enableVector(packet->data);
+    for (uint8_t priority = 0; priority < PFC::PriorityCount; ++priority) {
+        if ((enable & (1U << priority)) && pfcPaused(priority)) {
+            pfcPausedTicks[priority] += curTick() - pfcPauseStarts[priority];
+        }
+    }
+    PFC::apply(packet->data, pfcPauseUntil, curTick(), rnic->etherBandwidth);
+    ++pfcReceived;
+    for (uint8_t priority = 0; priority < PFC::PriorityCount; ++priority) {
+        if (!(enable & (1U << priority))) {
+            continue;
+        }
+        uint16_t quantum = PFC::pauseTime(packet->data, priority);
+        if (quantum) {
+            pfcPauseStarts[priority] = curTick();
+            ++pfcPauseCount[priority];
+        }
+        HANGU_PRINT(RdmaEngine, " PFC_RX priority %u quantum %u until %lu count %lu\n",
+            priority, quantum, pfcPauseUntil[priority], pfcReceived);
+    }
+    armSau();
+    return true;
+}
 
