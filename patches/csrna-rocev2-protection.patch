+        }
+    }
+    windowFull = windowSize >= windowCap;
+    updateQpDrain(qpn);
+    armRetransTimer();
+}
+
+bool
+HanGuRnic::RdmaEngine::retransWindow(WinMapElem *winElem, uint32_t qpn) {
+    if (winElem->retryCount >= rnic->params()->retrans_limit) {
+        failWindow(winElem, qpn);
+        return false;
+    }
+    ++winElem->retryCount;
+    winElem->recovering = true;
+    reTransPkt(winElem);
+    winElem->rnrDeadline = 0;
+    winElem->retransDeadline = 0;
+    return true;
+}
+
+void
+HanGuRnic::RdmaEngine::retransTimeout() {
+    for (auto &item : sndWindowList) {
+        WinMapElem *window = item.second;
+        if (!window->list || window->list->empty()) {
+            continue;
+        }
+        if (window->rnrDeadline && window->rnrDeadline <= curTick()) {
+            window->rnrDeadline = 0;
+            if (rnic->params()->rnr_retry_limit != 7 &&
+                    window->rnrCount >= rnic->params()->rnr_retry_limit) {
+                failWindow(window, item.first, IBV_WC_RNR_RETRY_EXC_ERR);
+            } else {
+                ++window->rnrCount;
+                HANGU_PRINT(RdmaEngine, " RC_RNR_RETRY qpn %u count %u\n",
+                    item.first, window->rnrCount);
+                reTransPkt(window);
+                window->retransDeadline = 0;
+            }
+        } else if (window->retransDeadline && window->retransDeadline <= curTick()) {
+            retransWindow(window, item.first);
+        }
+    }
+    armRetransTimer();
+}
