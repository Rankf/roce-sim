+void
+HanGuRnic::RdmaEngine::sendPfc(uint16_t enable,
+        const std::array<uint16_t, 8> &times) {
+    EthPacketPtr packet = std::make_shared<EthPacketData>(PFC::FrameSize);
+    packet->length = PFC::FrameSize;
+    packet->simLength = PFC::FrameSize;
+    uint64_t source = 0;
+    for (int index = 0; index < ETH_ADDR_LEN; ++index) {
+        source = (source << 8) | rnic->macAddr[index];
+    }
+    PFC::writeFrame(packet->data, source, enable, times);
+    queueTxPacket(packet, 0);
+    ++pfcTransmitted;
+    HANGU_PRINT(RdmaEngine, " PFC_TX enable 0x%x quantum %u tick %lu\n",
+        enable, times[3], curTick());
+}
