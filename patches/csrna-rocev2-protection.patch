+int atomic_contend_test(struct rdma_resc *resc) {
+    const uint32_t count = 64;
+    for (uint32_t i = 0; i < count; ++i) {
+        struct ibv_wqe wqe;
+        atomic_init_wqe(&wqe, resc, IBV_TYPE_ATOMIC_FAA, 0, i * 8,
+            1, 0, 0x4160000000000000UL | i);
+        if (ibv_post_send(resc->ctx, &wqe, resc->qp[i % 2], 1)) {
+            return 1;
+        }
+    }
+    uint32_t completed = 0;
+    while (completed < count) {
+        int res = ibv_poll_cpl(resc->cq[0], resc->desc, MAX_CPL_NUM);
+        for (int i = 0; i < res; ++i) {
+            if (resc->desc[i]->trans_type != IBV_TYPE_ATOMIC_FAA) {
+                continue;
+            }
+            uint64_t wr_id = resc->desc[i]->wr_id;
+            uint64_t original;
+            memcpy(&original, resc->mr[0]->addr + (wr_id & 0xffff) * 8,
+                sizeof(original));
+            RDMA_PRINT(Server, "ATOMIC_COMPETE_CQE wr_id=0x%lx status=%u old=0x%lx\n",
+                wr_id, resc->desc[i]->status, original);
+            if (resc->desc[i]->status) {
+                return resc->desc[i]->status;
+            }
+            ++completed;
+        }
+    }
+    uint8_t seen[count];
+    memset(seen, 0, sizeof(seen));
+    uint32_t unique = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+        uint64_t original;
+        memcpy(&original, resc->mr[0]->addr + i * 8, sizeof(original));
+        if (original < count && !seen[original]) {
+            seen[original] = 1;
+            ++unique;
+        }
+    }
+    RDMA_PRINT(Server, "ATOMIC_COMPETE_SUMMARY completed=%u unique_old=%u\n",
+        completed, unique);
+    return unique != count;
+}
