+void
+HanGuRnic::RdmaEngine::atomicRsp(EthPacketPtr rxPkt, WindowElemPtr winElem) {
+    MrReqRspPtr dataWreq = make_shared<MrReqRsp>(DMA_TYPE_WREQ,
+        TPT_WCHNL_TX_DATA, winElem->txDesc->lkey, sizeof(uint64_t),
+        winElem->txDesc->lVaddr & 0xFFF);
+    dataWreq->vaddr = winElem->txDesc->lVaddr;
+    dataWreq->hasVaddr = true;
+    dataWreq->pd = winElem->pd;
+    dataWreq->qpc = new QpcResc();
+    dataWreq->qpc->srcQpn = winElem->qpn;
+    dataWreq->qpc->cqn = winElem->cqn;
+    dataWreq->txDesc = winElem->txDesc;
+    dataWreq->wrDataReq = new uint8_t[sizeof(uint64_t)];
+    uint64_t original = RoCEv2::atomicOriginal(rxPkt->data);
+    memcpy(dataWreq->wrDataReq, &original, sizeof(original));
+    ++readLocalPending[winElem->qpn];
+    rnic->dataReqFifo.push(dataWreq);
+    if (!rnic->mrRescModule.transReqEvent.scheduled()) {
+        rnic->schedule(rnic->mrRescModule.transReqEvent,
+            curTick() + rnic->clockPeriod());
+    }
+    HANGU_PRINT(RdmaEngine, " ATOMIC_RESPONSE qpn %u PSN 0x%x old 0x%lx\n",
+        winElem->qpn, RoCEv2::psn(rxPkt->data), original);
+}
