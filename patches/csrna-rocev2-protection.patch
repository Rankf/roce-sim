 }
 
+RequestPtr
+DmaPort::dmaAtomicAction(Addr addr, int size, Event *event, uint8_t *data,
+    AtomicOpFunctorPtr atomic_op, uint32_t sid, uint32_t ssid, Tick delay,
+    Request::Flags flag)
+{
+    assert(size == 8 && (addr & 7) == 0 && atomic_op);
+    DmaReqState *reqState = new DmaReqState(event, size, delay);
+    RequestPtr req = std::make_shared<Request>(addr, size,
+        flag | Request::ATOMIC_RETURN_OP, requestorId);
+    req->setStreamId(sid);
+    req->setSubStreamId(ssid);
+    req->taskId(ContextSwitchTaskId::DMA);
+    req->setAtomicOpFunctor(std::move(atomic_op));
+    PacketPtr pkt = new Packet(req, MemCmd::SwapReq);
+    if (data)
+        pkt->dataStatic(data);
+    pkt->senderState = reqState;
+    DPRINTF(DMA, "Starting atomic DMA for addr: %#x size: %d\n", addr, size);
+    queueDma(pkt);
+    sendDma();
+    return req;
+}
+
 void
 DmaPort::queueDma(PacketPtr pkt)
 {
