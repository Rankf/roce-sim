+    args.qp_num = qp->qp_num;
+    args.drained = 0;
+    write_cmd(dvr->fd, HGKFD_IOC_QUERY_DRAIN, &args);
+    if (args.drained) {
+        qp->sq_draining = 0;
+        return 1;
+    }
+    return 0;
