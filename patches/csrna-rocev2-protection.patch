+DCQCN::Params
+HanGuRnic::RdmaEngine::dcqcnParams() const {
+    auto rate = [](float ticksPerByte) {
+        return uint64_t(8000000000000.0 / ticksPerByte + 0.5);
+    };
+    DCQCN::Params params;
+    params.maxRate = rate(rnic->params()->dcqcn_max_rate);
+    params.minRate = rate(rnic->params()->dcqcn_min_rate);
+    params.rateAI = rate(rnic->params()->dcqcn_rate_ai);
+    params.rateHAI = rate(rnic->params()->dcqcn_rate_hai);
+    params.rateOnFirstCnp = rnic->params()->dcqcn_first_cnp_gain;
+    params.alphaGain = rnic->params()->dcqcn_alpha_gain;
+    params.clampTargetRate = rnic->params()->dcqcn_clamp_target;
+    params.alphaInterval = rnic->params()->dcqcn_alpha_interval;
+    params.decreaseInterval = rnic->params()->dcqcn_decrease_interval;
+    params.recoveryInterval = rnic->params()->dcqcn_recovery_interval;
+    params.fastRecoveryTimes = rnic->params()->dcqcn_fast_recovery_times;
+    params.dualTrigger = rnic->params()->dcqcn_dual_trigger;
+    params.byteRecoveryBytes = rnic->params()->dcqcn_byte_recovery_bytes;
+    return params;
+}
