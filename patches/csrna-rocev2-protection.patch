+    failedQps.insert(qpn);
+    while (!winElem->list->empty()) {
+        TxDescPtr desc = winElem->list->front()->txDesc;
+        if (desc != previous) {
+            postTxCpl(QP_TYPE_RC, qpn, winElem->cqn, desc,
