+void
+HanGuRnic::RdmaEngine::pfcPortReset() {
+    for (uint8_t priority = 0; priority < PFC::PriorityCount; ++priority) {
+        if (pfcPaused(priority)) {
+            pfcPausedTicks[priority] += curTick() - pfcPauseStarts[priority];
+        }
+        pfcPauseUntil[priority] = 0;
+    }
+    HANGU_PRINT(RdmaEngine, " PFC_PORT_RESET tick %lu\n", curTick());
+    armSau();
+}
