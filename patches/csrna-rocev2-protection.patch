+    uint32_t completed = 0;
+    while (completed != 3) {
+        int res = ibv_poll_cpl(resc->cq[0], resc->desc, MAX_CPL_NUM);
+        for (int i = 0; i < res; ++i) {
+            uint8_t type = resc->desc[i]->trans_type;
+            if (type != IBV_TYPE_RDMA_READ && type != IBV_TYPE_RDMA_WRITE) {
+                continue;
+            }
+            RDMA_PRINT(Server, "TX_CQE mode=56 status=%u byte_cnt=%u wr_id=0x%lx\n",
