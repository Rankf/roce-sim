+void
+HanGuRnic::RdmaEngine::releaseReadCredit(uint32_t qpn, TxDescPtr desc) {
+    if (!isReadAtomicOpcode(desc->opcode)) {
+        return;
+    }
+    if (desc->reserved & TX_DESC_READ_CHARGED) {
+        desc->reserved &= ~TX_DESC_READ_CHARGED;
+        if (readOutstanding[qpn]) {
+            --readOutstanding[qpn];
+        }
+        readCreditWait.erase(qpn);
+        HANGU_PRINT(RdmaEngine, " READ_CREDIT_RELEASE qpn %u outstanding %u\n",
+            qpn, readOutstanding[qpn]);
+    }
+    if (readFencePending[qpn]) {
+        --readFencePending[qpn];
+    }
+    if (!rgrrEvent.scheduled()) {
+        rnic->schedule(rgrrEvent, curTick() + rnic->clockPeriod());
+    }
+    if (!readFencePending[qpn] && dp2ddIdxFifo.size() &&
+            rnic->txdescRspFifo.size() &&
+            ((allowNewDb && df2ddFifo.size()) || !allowNewDb) &&
+            !dduEvent.scheduled()) {
+        rnic->schedule(dduEvent, curTick() + rnic->clockPeriod());
+    }
+}
