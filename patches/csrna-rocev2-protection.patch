+int ibv_update_mr(struct ibv_context *context, struct ibv_mr *mr, enum ibv_mr_flag flag, uint32_t pd) {
+    struct hghca_context *dvr = (struct hghca_context *)context->dvr;
+    struct kfd_ioctl_write_mpt_args *args =
+        (struct kfd_ioctl_write_mpt_args *)malloc(sizeof(struct kfd_ioctl_write_mpt_args));
+    args->batch_size = 1;
+    args->flag[0] = flag;
+    args->addr[0] = (uint64_t)mr->addr;
+    args->length[0] = mr->length;
+    args->mtt_index[0] = mr->mtt[0].mtt_index;
+    args->mpt_index[0] = mr->lkey;
+    args->pd[0] = pd;
+    args->valid[0] = mr->valid;
+    write_cmd(dvr->fd, HGKFD_IOC_WRITE_MPT, (void *)args);
+    free(args);
+    mr->flag = flag;
+    return 0;
+}
+
+int ibv_invalidate_mr(struct ibv_context *context, struct ibv_mr *mr) {
+    mr->valid = 0;
+    return ibv_update_mr(context, mr, mr->flag, context->pd);
