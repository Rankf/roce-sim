+DCQCN::State &
+HanGuRnic::RdmaEngine::pacerState(uint32_t qpn) {
+    auto inserted = dcqcnStates.emplace(qpn, DCQCN::State());
+    if (inserted.second) {
+        uint64_t fixedRate = uint64_t(8000000000000.0 /
+            rnic->params()->pacing_rate + 0.5);
+        DCQCN::initialize(inserted.first->second, dcqcnParams(),
+            rnic->params()->enable_dcqcn ? 0 : fixedRate);
+    }
+    return inserted.first->second;
+}
 
+bool
+HanGuRnic::RdmaEngine::isPaced(uint8_t opcode) const {
+    switch (opcode) {
+      case RoCEv2::RcSendFirst:
+      case RoCEv2::RcSendMiddle:
+      case RoCEv2::RcSendLast:
+      case RoCEv2::RcSendLastWithImmediate:
+      case RoCEv2::RcSendOnly:
+      case RoCEv2::RcSendOnlyWithImmediate:
+      case RoCEv2::RcSendLastWithInvalidate:
+      case RoCEv2::RcSendOnlyWithInvalidate:
+      case RoCEv2::RcWriteFirst:
+      case RoCEv2::RcWriteMiddle:
+      case RoCEv2::RcWriteLast:
+      case RoCEv2::RcWriteOnly:
+      case RoCEv2::RcWriteOnlyWithImmediate:
+      case RoCEv2::RcReadRequest:
+      case RoCEv2::RcCompareSwap:
+      case RoCEv2::RcFetchAdd:
+      case RoCEv2::RcReadResponseFirst:
+      case RoCEv2::RcReadResponseMiddle:
+      case RoCEv2::RcReadResponseLast:
+      case RoCEv2::RcReadResponseOnly:
+      case RoCEv2::RcAtomicAcknowledge:
+        return true;
+      default:
+        return false;
+    }
+}
