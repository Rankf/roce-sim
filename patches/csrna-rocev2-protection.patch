+        ibv_modify_qp_state(resc->ctx, qp, IBV_QPS_RESET, IBV_QP_STATE) ||
+        ibv_modify_qp_state(resc->ctx, qp, IBV_QPS_INIT, init_mask) ||
+        ibv_modify_qp_state(resc->ctx, qp, IBV_QPS_RTR, rtr_mask) ||
+        ibv_modify_qp_state(resc->ctx, qp, IBV_QPS_RTS, rts_mask)) {
+        return 1;
+    }
+    uint32_t flushed = 0, success = 0;
+    while (!flushed) {
+        int res = ibv_poll_cpl(resc->cq[0], resc->desc, MAX_CPL_NUM);
+        for (int i = 0; i < res; ++i) {
+            if (resc->desc[i]->trans_type == IBV_TYPE_RDMA_WRITE && resc->desc[i]->status) {
+                ++flushed;
+                RDMA_PRINT(Server, "QP_RESET_FLUSH status=%u\n", resc->desc[i]->status);
+            }
+        }
+    }
+    svr_post_send(resc, qp, 1, 0, OPMODE_RDMA_WRITE);
+    while (!success) {
+        int res = ibv_poll_cpl(resc->cq[0], resc->desc, MAX_CPL_NUM);
+        for (int i = 0; i < res; ++i) {
+            if (resc->desc[i]->trans_type == IBV_TYPE_RDMA_WRITE && !resc->desc[i]->status) {
+                ++success;
+                RDMA_PRINT(Server, "QP_RESET_SUCCESS status=%u\n", resc->desc[i]->status);
+            }
+        }
+    }
+    RDMA_PRINT(Server, "QP_RESET_SUMMARY flushed=%u success=%u\n", flushed, success);
+    return flushed != 1 || success != 1;
+}
