+bool
+HanGuRnic::RdmaEngine::isQpDrained(uint32_t qpn) {
+    auto window = sndWindowList.find(qpn);
+    if (window != sndWindowList.end() && window->second->list &&
+            !window->second->list->empty()) {
+        return false;
+    }
+    return !readLocalPending[qpn] && !txCompletionPending[qpn];
+}
