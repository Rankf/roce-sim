+                resc->desc[i]->wr_id);
+            if (resc->desc[i]->status) {
+                return resc->desc[i]->status;
+            }
+            completed |= 1U << (type == IBV_TYPE_RDMA_WRITE);
+        }
+    }
+    return 0;
+}
