+    if ((attr_mask & IBV_QP_MAX_DEST_RD_ATOMIC) && !qp->max_dest_rd_atomic) {
+        return -1;
+    }
+    uint8_t old_state = qp->state;
+    qp->state = state;
+    if (state == IBV_QPS_SQD) {
+        qp->sq_draining = 1;
+    }
+    if (attr_mask == IBV_QP_STATE &&
+            (state == IBV_QPS_SQD || (old_state == IBV_QPS_SQD && state == IBV_QPS_RTS))) {
+        struct hghca_context *dvr = (struct hghca_context *)context->dvr;
+        struct kfd_ioctl_set_qp_state_args args;
+        args.qp_num = qp->qp_num;
+        args.state = state;
+        write_cmd(dvr->fd, HGKFD_IOC_SET_QP_STATE, &args);
+        return 0;
+    }
+    if (state == IBV_QPS_RESET) {
+        qp->sq_outstanding = 0;
+        qp->rq_outstanding = 0;
+        qp->sq_unsignaled = 0;
+    }
+    if (ibv_modify_qp(context, qp)) {
