+void
+HanGuRnic::RdmaEngine::bindMw(MrReqRspPtr req) {
+    TxDescPtr desc = req->txDesc;
+    uint32_t rkey = desc->rdmaType.rkey;
+    uint32_t index = rkey >> 8;
+    auto existing = mwTable.end();
+    for (auto it = mwTable.begin(); it != mwTable.end(); ++it) {
+        if (it->second->index == index) {
+            existing = it;
+            break;
+        }
+    }
+    if (existing != mwTable.end() && existing->second->state != MW_FREE) {
+        postTxCpl(QP_TYPE_RC, req->qpc->srcQpn, req->qpc->cqn, desc,
+            IBV_WC_MW_BIND_ERR);
+        return;
+    }
+    MwRescPtr mw;
+    if (existing == mwTable.end()) {
+        mw = std::make_shared<MwResc>();
+        mw->index = index;
+    } else {
+        mw = existing->second;
+        uint32_t oldRkey = existing->first;
+        mwTable.erase(existing);
+        HANGU_PRINT(RdmaEngine,
+            " MW_REBIND rkey old 0x%x new 0x%x handle %p index 0x%x tag 0x%x\n",
+            oldRkey, rkey, static_cast<void *>(mw.get()), index, rkey & 0xff);
+    }
+    mw->state = MW_VALID;
+    mw->rkey = rkey;
+    mw->pd = req->qpc->pd;
+    mw->boundQpn = req->qpc->srcQpn;
+    mw->mrLkey = desc->lkey;
+    mw->addr = desc->lVaddr;
+    mw->length = desc->len;
+    mw->access = desc->immData;
+    mw->refs = 0;
+    mwTable[rkey] = mw;
+    HANGU_PRINT(RdmaEngine,
+        " MW_BIND rkey 0x%x handle %p index 0x%x tag 0x%x qpn %u pd %u "
+        "addr 0x%lx length %u access 0x%x\n",
+        rkey, static_cast<void *>(mw.get()), index, rkey & 0xff,
+        mw->boundQpn, mw->pd, mw->addr, mw->length, mw->access);
+    postTxCpl(QP_TYPE_RC, req->qpc->srcQpn, req->qpc->cqn, desc);
+}
+
+void
+HanGuRnic::RdmaEngine::localInvalidate(TxDescPtr desc, QpcResc *qpc) {
+    uint32_t rkey = desc->rdmaType.rkey;
+    auto found = mwTable.find(rkey);
+    if (found == mwTable.end() || found->second->state == MW_FREE) {
+        HANGU_PRINT(RdmaEngine, " MW_LOCAL_INV_NOOP rkey 0x%x\n", rkey);
+        postTxCpl(QP_TYPE_RC, qpc->srcQpn, qpc->cqn, desc);
+        return;
+    }
+    MwRescPtr mw = found->second;
+    mw->state = MW_RETIRING;
+    MrReqRspPtr pending = make_shared<MrReqRsp>(DMA_TYPE_WREQ,
+        TPT_WCHNL_TX_DATA, desc->lkey, 0, 0);
+    pending->txDesc = desc;
+    pending->qpc = new QpcResc(*qpc);
+    pending->invalidateMw = mw;
+    if (mw->refs) {
+        mwLocalInvWait.push(pending);
+    } else {
+        mw->state = MW_FREE;
+        postTxCpl(QP_TYPE_RC, qpc->srcQpn, qpc->cqn, desc);
+    }
+    HANGU_PRINT(RdmaEngine, " MW_LOCAL_INV rkey 0x%x refs %u\n", rkey, mw->refs);
+}
+
+void
+HanGuRnic::RdmaEngine::resolveMw(MrReqRspPtr req) {
+    if (!req->remote) {
+        return;
+    }
+    auto found = mwTable.find(req->lkey);
+    if (found == mwTable.end()) {
+        return;
+    }
+    req->mw = found->second;
+    req->lkey = req->mw->mrLkey;
+}
+
+void
+HanGuRnic::RdmaEngine::releaseMw(MrReqRspPtr req) {
+    if (req->mw && req->mwInFlight) {
+        MwRescPtr mw = req->mw;
+        req->mwInFlight = false;
+        if (mw->refs) {
+            --mw->refs;
+        }
+        HANGU_PRINT(RdmaEngine, " MW_RELEASE rkey 0x%x refs %u state %u\n",
+            mw->rkey, mw->refs, mw->state);
+    }
+    while (!mwLocalInvWait.empty() &&
+            mwLocalInvWait.front()->invalidateMw->refs == 0) {
+        MrReqRspPtr pending = mwLocalInvWait.front();
+        mwLocalInvWait.pop();
+        pending->invalidateMw->state = MW_FREE;
+        postTxCpl(QP_TYPE_RC, pending->qpc->srcQpn, pending->qpc->cqn,
+            pending->txDesc);
+    }
+    while (!mwRetireWait.empty() &&
+            mwRetireWait.front()->invalidateMw->refs == 0) {
+        MrReqRspPtr pending = mwRetireWait.front();
+        mwRetireWait.pop();
+        pending->invalidateMw->state = MW_FREE;
+        finishReceive(pending);
+    }
+}
+
+void
+HanGuRnic::RdmaEngine::retireMw(MrReqRspPtr req) {
+    uint32_t rkey = RoCEv2::iethRkey(req->requestPkt->data);
+    auto found = mwTable.find(rkey);
+    if (found == mwTable.end()) {
+        return;
+    }
+    MwRescPtr mw = found->second;
+    req->invalidateMw = mw;
+    mw->state = MW_RETIRING;
+    if (!mw->refs) {
+        mw->state = MW_FREE;
+    }
+    HANGU_PRINT(RdmaEngine, " MW_REMOTE_INV rkey 0x%x refs %u\n", rkey, mw->refs);
+}
+
+void
+HanGuRnic::RdmaEngine::deallocMw(uint32_t rkey) {
+    auto found = mwTable.find(rkey);
+    if (found != mwTable.end()) {
+        found->second->state = MW_INVALID;
+        mwTable.erase(found);
+        HANGU_PRINT(RdmaEngine, " MW_DEALLOC rkey 0x%x\n", rkey);
+    }
+}
