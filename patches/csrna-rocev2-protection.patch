+static int atomic_execute(struct rdma_resc *resc, struct ibv_qp *qp,
+    enum ibv_trans_func type, uint64_t remote_offset, uint32_t local_offset,
+    uint64_t swap_or_add, uint64_t compare, uint64_t wr_id) {
+    struct ibv_wqe wqe;
+    memset(&wqe, 0, sizeof(wqe));
+    wqe.trans_type = type;
+    wqe.flag = WR_FLAG_SIGNALED;
+    wqe.mr = resc->mr[0];
+    wqe.offset = local_offset;
+    wqe.length = sizeof(uint64_t);
+    wqe.rdma.raddr = resc->rinfo->raddr + remote_offset;
+    wqe.rdma.rkey = resc->rinfo->rkey;
+    wqe.atomic.swap_or_add = swap_or_add;
+    wqe.atomic.compare = compare;
+    wqe.wr_id = wr_id;
+    int rc = ibv_post_send(resc->ctx, &wqe, qp, 1);
+    if (rc) {
+        RDMA_PRINT(Server, "ATOMIC_SUBMIT_ERROR wr_id=0x%lx\n", wr_id);
+        return -1;
+    }
+    while (1) {
+        int res = ibv_poll_cpl(resc->cq[0], resc->desc, MAX_CPL_NUM);
+        for (int i = 0; i < res; ++i) {
+            if (resc->desc[i]->trans_type == type &&
+                    resc->desc[i]->wr_id == wr_id) {
+                uint64_t original;
+                memcpy(&original, resc->mr[0]->addr + local_offset, sizeof(original));
+                RDMA_PRINT(Server,
+                    "ATOMIC_CQE type=%u status=%u byte_cnt=%u wr_id=0x%lx old=0x%lx\n",
+                    type, resc->desc[i]->status, resc->desc[i]->byte_cnt,
+                    wr_id, original);
+                return resc->desc[i]->status;
+            }
+        }
+    }
+}
