+    ++denied;
+    if (ibv_update_mr(resc->ctx, resc->mr[0], flags, 1)) {
+        return 1;
+    }
+    mw->rkey = 0x101;
+    if (mw_bind(resc, resc->qp[0], mw, 8184, 16, MR_FLAG_RD,
+            0x4d57000000000011UL) != IBV_WC_MW_BIND_ERR) {
+        return 1;
+    }
+    ++denied;
+    if (ibv_update_mr(resc->ctx, resc->mr[0], flags & ~MR_FLAG_WR, 1)) {
+        return 1;
+    }
+    mw->rkey = 0x102;
+    if (mw_bind(resc, resc->qp[0], mw, 0, 512, MR_FLAG_WR,
+            0x4d57000000000012UL) != IBV_WC_MW_BIND_ERR) {
+        return 1;
+    }
+    ++denied;
+    if (ibv_update_mr(resc->ctx, resc->mr[0], flags, 1)) {
+        return 1;
+    }
+    mw->rkey = 0x999;
+    int noop = mw_local_inv(resc, resc->qp[0], mw, 0x4d57000000000013UL);
+    RDMA_PRINT(Server, "MW02_SUMMARY denied=%u noop=%u\n", denied, noop);
