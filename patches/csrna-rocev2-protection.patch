+void
+HanGuRnic::RdmaEngine::sequenceNakProcessing(EthPacketPtr rxPkt,
+        WinMapElem *winElem, uint32_t qpn) {
+    uint32_t nakPsn = RoCEv2::psn(rxPkt->data);
+    HANGU_PRINT(RdmaEngine, " RC_NAK_SEQUENCE qpn %u PSN 0x%x first 0x%x\n",
+        qpn, nakPsn, winElem->firstPsn);
+    if (winElem->recovering) {
+        HANGU_PRINT(RdmaEngine, " RC_RECOVERY_PENDING qpn %u\n", qpn);
+        return;
+    }
+    while (!winElem->list->empty() && winElem->firstPsn != nakPsn) {
+        WindowElemPtr current = winElem->list->front();
+        uint8_t opcode = RoCEv2::opcode(current->txPkt->data);
+        if (opcode == RoCEv2::RcReadRequest || opcode == RoCEv2::RcCompareSwap ||
+                opcode == RoCEv2::RcFetchAdd) {
+            winElem->list->pop_front();
+            --windowSize;
+            winElem->firstPsn = RoCEv2::psnAdd(winElem->firstPsn, 1);
+            continue;
+        }
+        if (current->final) {
+            postTxCpl(QP_TYPE_RC, qpn, winElem->cqn, current->txDesc);
+        }
+        winElem->list->pop_front();
+        --windowSize;
+        winElem->firstPsn = RoCEv2::psnAdd(winElem->firstPsn, 1);
+    }
+    windowFull = windowSize >= windowCap;
+    if (winElem->list->empty()) {
+        winElem->retransDeadline = 0;
+    } else {
+        retransWindow(winElem, qpn);
+    }
+    armRetransTimer();
 }
 
 
