+bool
+HanGuRnic::RdmaEngine::postCompletion(uint32_t cqn, uint8_t channel) {
+    if (failedCqs.count(cqn)) {
+        return false;
+    }
+    uint32_t count = cqCompletionCounts[cqn];
+    if (cqn && count >= rnic->params()->cq_capacity) {
+        failedCqs.insert(cqn);
+        HANGU_PRINT(RdmaEngine, " IBV_EVENT_CQ_ERR cqn %u: CQ overrun, CQ disabled\n", cqn);
+        return false;
+    }
+    cqCompletionCounts[cqn] = count + 1;
+    CxtReqRspPtr cqcReq = make_shared<CxtReqRsp>(CXT_RREQ_CQ, channel, cqn);
+    cqcReq->txCqcRsp = new CqcResc;
+    rnic->cqcModule.postCqcReq(cqcReq);
+    return true;
+}
