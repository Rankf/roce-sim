+void
+HanGuRnic::tracePacket(EthPacketPtr packet) {
+    if (!packetTrace.is_open()) {
+        return;
+    }
+    auto write32 = [this](uint32_t value) {
+        char bytes[4] = {char(value), char(value >> 8),
+            char(value >> 16), char(value >> 24)};
+        packetTrace.write(bytes, sizeof(bytes));
+    };
+    Tick now = curTick();
+    write32(now / 1000000000000ULL);
+    write32((now % 1000000000000ULL) / 1000000ULL);
+    write32(packet->length);
+    write32(packet->length);
+    packetTrace.write(reinterpret_cast<const char *>(packet->data),
+        packet->length);
+    packetTrace.flush();
+}
+
+HanGuRnic::RxLease::~RxLease() {
+    if (state->owner && state->active) {
+        state->owner->rxRelease(state, bytes, priority);
+    } else {
+        state->totalBytes -= bytes;
+        state->priorityBytes[priority] -= bytes;
+        --state->totalPackets;
+    }
+}
+
+bool
+HanGuRnic::rxAcquire(EthPacketPtr packet) {
+    if (!params()->enable_rx_buffer || PFC::isPfc(packet->data, packet->length)) {
+        return true;
+    }
+    uint8_t priority = PFC::priority(PFC::dscp(packet->data));
+    uint64_t capacity = params()->rx_buffer_size;
+    uint64_t limit = capacity;
+    if (params()->enable_pfc && priority != params()->rx_pfc_priority) {
+        limit = std::min<uint64_t>(limit, params()->rx_pfc_xoff);
+    }
+    if (rxBufferState->totalBytes + packet->length > limit ||
+            rxBufferState->totalBytes + packet->length > capacity) {
+        ++rxBufferState->droppedPackets;
+        rxBufferState->droppedBytes += packet->length;
+        HANGU_PRINT(HanGuRnic, " RX_BUFFER_DROP bytes %u priority %u occupied %lu "
+            "capacity %lu drops %lu\n", packet->length, priority,
+            rxBufferState->totalBytes, capacity, rxBufferState->droppedPackets);
+        return false;
+    }
+    rxBufferState->totalBytes += packet->length;
+    ++rxBufferState->totalPackets;
+    rxBufferState->priorityBytes[priority] += packet->length;
+    rxBufferState->priorityPeak[priority] = std::max(
+        rxBufferState->priorityPeak[priority], rxBufferState->priorityBytes[priority]);
+    packet->context = std::make_shared<RxLease>(rxBufferState, packet->length, priority);
+    HANGU_PRINT(HanGuRnic, " RX_BUFFER_EVENT action=acquire bytes=%u priority=%u "
+        "occupied=%lu priority_bytes=%lu packets=%lu\n", packet->length, priority,
+        rxBufferState->totalBytes, rxBufferState->priorityBytes[priority],
+        rxBufferState->totalPackets);
+    if (params()->enable_pfc && priority == params()->rx_pfc_priority &&
+            rxBufferState->priorityBytes[priority] >= params()->rx_pfc_xoff &&
+            !rxBufferState->xoff[priority]) {
+        rxBufferState->xoff[priority] = true;
+        ++rxXoffCount;
+        ++rxPfcSent;
+        HANGU_PRINT(HanGuRnic, " RX_XOFF priority=%u occupied=%lu quantum=%u\n",
+            priority, rxBufferState->priorityBytes[priority], params()->rx_pfc_pause_quanta);
+        rdmaEngine.sendRxPfc(priority, params()->rx_pfc_pause_quanta);
+        if (!rxPfcRefreshEvent.scheduled()) {
+            schedule(rxPfcRefreshEvent, curTick() + params()->rx_pfc_refresh_interval);
+        }
+    }
+    return true;
+}
+
+void
+HanGuRnic::rxRelease(std::shared_ptr<RxBufferState> state, uint32_t bytes,
+        uint8_t priority) {
+    assert(state == rxBufferState && state->totalBytes >= bytes &&
+        state->priorityBytes[priority] >= bytes && state->totalPackets);
+    state->totalBytes -= bytes;
+    state->priorityBytes[priority] -= bytes;
+    --state->totalPackets;
+    HANGU_PRINT(HanGuRnic, " RX_BUFFER_EVENT action=release bytes=%u priority=%u "
+        "occupied=%lu priority_bytes=%lu packets=%lu\n", bytes, priority,
+        state->totalBytes, state->priorityBytes[priority], state->totalPackets);
+    if (state->xoff[priority] && state->priorityBytes[priority] <= params()->rx_pfc_xon) {
+        state->xoff[priority] = false;
+        ++rxXonCount;
+        ++rxPfcSent;
+        HANGU_PRINT(HanGuRnic, " RX_XON priority=%u occupied=%lu\n",
+            priority, state->priorityBytes[priority]);
+        rdmaEngine.sendRxPfc(priority, 0);
+        bool anyXoff = false;
+        for (bool active : state->xoff) anyXoff = anyXoff || active;
+        if (!anyXoff && rxPfcRefreshEvent.scheduled()) {
+            deschedule(rxPfcRefreshEvent);
+        }
+    }
+}
+
+void
+HanGuRnic::rxPfcRefresh() {
+    bool anyXoff = false;
+    for (uint8_t priority = 0; priority < PFC::PriorityCount; ++priority) {
+        if (!rxBufferState->xoff[priority]) continue;
+        anyXoff = true;
+        if (rxBufferState->priorityBytes[priority] > params()->rx_pfc_xon) {
+            ++rxPfcSent;
+            HANGU_PRINT(HanGuRnic, " RX_PFC_REFRESH priority=%u occupied=%lu\n",
+                priority, rxBufferState->priorityBytes[priority]);
+            rdmaEngine.sendRxPfc(priority, params()->rx_pfc_pause_quanta);
+        }
+    }
+    if (anyXoff) {
+        schedule(rxPfcRefreshEvent, curTick() + params()->rx_pfc_refresh_interval);
+    }
+}
