+static int clt_fixed_write_test(struct rdma_resc *resc) {
+    uint32_t success = 0, failure = 0;
+    for (uint32_t request = 0; request < fixed_wr_num; ++request) {
+        struct ibv_wqe wqe;
+        memset(&wqe, 0, sizeof(wqe));
+        wqe.trans_type = IBV_TYPE_RDMA_WRITE;
+        wqe.flag = WR_FLAG_SIGNALED;
+        wqe.mr = resc->mr[0];
+        wqe.length = 64;
+        wqe.rdma.raddr = resc->rinfo[0].raddr;
+        wqe.rdma.rkey = resc->rinfo[0].rkey;
+        wqe.wr_id = 0x42494e4700000000UL | request;
+        if (ibv_post_send(resc->ctx, &wqe, resc->qp[0], 1)) {
+            return 1;
+        }
+        while (success + failure <= request) {
+            int res = ibv_poll_cpl(resc->cq[0], resc->desc, MAX_CPL_NUM);
+            for (int i = 0; i < res; ++i) {
+                if (resc->desc[i]->trans_type == IBV_TYPE_RDMA_WRITE &&
+                        resc->desc[i]->wr_id == wqe.wr_id) {
+                    if (resc->desc[i]->status) {
+                        ++failure;
+                    } else {
+                        ++success;
+                    }
+                }
+            }
+        }
+    }
+    RDMA_PRINT(Client, "CLT_FIXED_SUMMARY submitted=%u success=%u failure=%u outstanding=%u\n",
+        fixed_wr_num, success, failure, fixed_wr_num - success - failure);
+    return failure != 0;
