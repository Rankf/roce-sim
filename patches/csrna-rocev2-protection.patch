+int dcqcn_sustained_test(struct rdma_resc *resc, uint8_t op_mode) {
+    uint8_t expected_type = op_mode == OPMODE_RDMA_WRITE ? IBV_TYPE_RDMA_WRITE : IBV_TYPE_RDMA_READ;
+    uint32_t submitted = 0, completed = 0, failure = 0;
+    while (submitted < fixed_wr_num) {
+        uint32_t count = fixed_wr_num - submitted < 8 ? fixed_wr_num - submitted : 8;
+        svr_post_send(resc, resc->qp[0], count, 0, op_mode);
+        while (completed < submitted + count) {
+            int res = ibv_poll_cpl(resc->cq[0], resc->desc, MAX_CPL_NUM);
+            for (int i = 0; i < res; ++i) {
+                if (resc->desc[i]->trans_type == expected_type) {
+                    failure += resc->desc[i]->status != 0;
+                    ++completed;
+                }
+            }
+        }
+        submitted += count;
+    }
+    RDMA_PRINT(Server, "DCQCN_FLOW_SUMMARY submitted=%u success=%u failure=%u outstanding=%u\n",
+        submitted, completed - failure, failure, submitted - completed);
+    return failure != 0;
+}
+
+int fixed_test(struct rdma_resc *resc, uint8_t op_mode) {
+    uint8_t expected_type = op_mode == OPMODE_RDMA_WRITE ? IBV_TYPE_RDMA_WRITE : IBV_TYPE_RDMA_READ;
+    uint32_t success = 0, failure = 0;
+    for (uint32_t request = 0; request < fixed_wr_num; ++request) {
+        svr_post_send(resc, resc->qp[0], 1, 0, op_mode);
+        while (1) {
+            int res = ibv_poll_cpl(resc->cq[0], resc->desc, MAX_CPL_NUM);
+            for (int i = 0; i < res; ++i) {
+                if (resc->desc[i]->trans_type == expected_type) {
+                    if (resc->desc[i]->status) {
+                        ++failure;
+                    } else {
+                        ++success;
+                    }
+                    goto completed;
+                }
+            }
+        }
+completed:
+        ;
+    }
+    RDMA_PRINT(Server, "FIXED_SUMMARY submitted=%u success=%u failure=%u outstanding=%u\n",
+        fixed_wr_num, success, failure, fixed_wr_num - success - failure);
+    return failure != 0;
+}
