+            0x4d57000000000073UL) != IBV_WC_REM_ACCESS_ERR ||
+        mw_rdma(resc, resc->qp[0], IBV_TYPE_RDMA_READ, second->rkey, 0, 64,
+            0x4d57000000000074UL)) {
+        return 1;
+    }
+    first->rkey = 0x105;
+    if (mw_bind(resc, resc->qp[0], first, 0, 512, MR_FLAG_RD,
+            0x4d57000000000075UL)) {
+        return 1;
+    }
+    for (uint32_t i = 0; i < 16; ++i) {
+        if (mw_local_inv(resc, resc->qp[0], first,
+                0x4d57000000000080UL | i)) {
+            return 1;
+        }
+        first->rkey = ibv_inc_rkey(first->rkey);
+        if (mw_bind(resc, resc->qp[0], first, 0, 512, MR_FLAG_RD,
+                0x4d57000000000090UL | i)) {
+            return 1;
+        }
+    }
+    if (mw_local_inv(resc, resc->qp[0], first, 0x4d570000000000a0UL)) {
+        return 1;
+    }
+    first->rkey = (first->rkey & 0xffffff00u) | 0xfeu;
+    if (mw_bind(resc, resc->qp[0], first, 0, 512, MR_FLAG_RD,
+            0x4d570000000000a1UL) || rdma_recv_sync(resc) ||
+        mw_rdma(resc, resc->qp[0], IBV_TYPE_RDMA_READ, first->rkey, 0, 64,
+            0x4d570000000000a2UL) ||
+        mw_local_inv(resc, resc->qp[0], first, 0x4d570000000000a3UL)) {
+        return 1;
+    }
+    first->rkey = ibv_inc_rkey(first->rkey);
+    if (mw_bind(resc, resc->qp[0], first, 0, 512, MR_FLAG_RD,
+            0x4d570000000000a4UL) || rdma_recv_sync(resc) ||
+        mw_rdma(resc, resc->qp[0], IBV_TYPE_RDMA_READ, first->rkey, 0, 64,
+            0x4d570000000000a5UL) ||
+        mw_rdma(resc, resc->qp[0], IBV_TYPE_RDMA_READ, first->rkey - 1, 0, 64,
+            0x4d570000000000a6UL) != IBV_WC_REM_ACCESS_ERR ||
+        mw_local_inv(resc, resc->qp[0], first, 0x4d570000000000a7UL)) {
+        return 1;
+    }
+    first->rkey = ibv_inc_rkey(first->rkey);
+    if (mw_bind(resc, resc->qp[0], first, 0, 512, MR_FLAG_RD,
+            0x4d570000000000a8UL) || rdma_recv_sync(resc) ||
+        mw_rdma(resc, resc->qp[0], IBV_TYPE_RDMA_READ, first->rkey, 0, 64,
+            0x4d570000000000a9UL) ||
+        mw_rdma(resc, resc->qp[0], IBV_TYPE_RDMA_READ, 0x1ff, 0, 64,
+            0x4d570000000000aaUL) != IBV_WC_REM_ACCESS_ERR ||
+        mw_local_inv(resc, resc->qp[0], first, 0x4d570000000000abUL)) {
+        return 1;
+    }
+    first->rkey = ibv_inc_rkey(first->rkey);
+    if (mw_bind(resc, resc->qp[0], first, 0, 512, MR_FLAG_RD,
+            0x4d570000000000acUL) || rdma_recv_sync(resc) ||
+        mw_rdma(resc, resc->qp[0], IBV_TYPE_RDMA_READ, first->rkey, 0, 64,
+            0x4d570000000000adUL) ||
+        mw_rdma(resc, resc->qp[0], IBV_TYPE_RDMA_READ, first->rkey - 1, 0, 64,
+            0x4d570000000000aeUL) != IBV_WC_REM_ACCESS_ERR) {
+        return 1;
+    }
+    ibv_dealloc_mw(resc->ctx, first);
+    ibv_dealloc_mw(resc->ctx, second);
+    RDMA_PRINT(Server, "MW08_SUMMARY reuse=16 key_wrap=1 independent=1\n");
+    return 0;
+}
