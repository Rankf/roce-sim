+            sndWindowList[qpc->srcQpn]->lastPsn = segmentPsn;
+        }
+        if (RoCEv2::psnCompare(segmentPsn, sndWindowList[qpc->srcQpn]->lastPsn) > 0) {
+            sndWindowList[qpc->srcQpn]->lastPsn = segmentPsn;
