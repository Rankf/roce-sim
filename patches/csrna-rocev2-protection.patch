+static void ring_init_wqe(struct ibv_wqe *wqe, struct rdma_resc *resc,
+    uint32_t sequence) {
+    uint32_t offset = (sequence * 64) & 8191;
+    uint32_t qp_index = sequence % 2;
+    uint32_t ordinal = sequence < 4 ? sequence :
+        (1 - qp_index) * 4 + (sequence - 4) / 2;
+    memset(wqe, 0, sizeof(*wqe));
+    wqe->trans_type = IBV_TYPE_RDMA_WRITE;
+    wqe->flag = ordinal % 4 == 3 ||
+        sequence + 2 >= (fixed_wr_num ? fixed_wr_num : 320) ? WR_FLAG_SIGNALED : 0;
+    wqe->mr = resc->mr[0];
+    wqe->offset = offset;
+    wqe->length = 64;
+    wqe->rdma.raddr = resc->rinfo->raddr + offset;
+    wqe->rdma.rkey = resc->rinfo->rkey;
+    wqe->wr_id = 0x5757000000000000UL | sequence;
+}
+
+static int ring_poll(struct rdma_resc *resc, uint32_t *completions) {
+    int res = ibv_poll_cpl(resc->cq[0], resc->desc, MAX_CPL_NUM);
+    for (int i = 0; i < res; ++i) {
+        if (resc->desc[i]->trans_type != IBV_TYPE_RDMA_WRITE) {
+            continue;
+        }
+        RDMA_PRINT(Server, "RING_CQE qpn=%u status=%u byte_cnt=%u wr_id=0x%lx\n",
+            resc->desc[i]->qp_num, resc->desc[i]->status,
+            resc->desc[i]->byte_cnt, resc->desc[i]->wr_id);
+        if (resc->desc[i]->status) {
+            return -1;
+        }
+        ++*completions;
+    }
+    return 0;
+}
