+void
+HanGuRnic::RdmaEngine::armDcqcnTimer() {
+    Tick next = 0;
+    for (const auto &entry : dcqcnStates) {
+        const DCQCN::State &state = entry.second;
+        const Tick deadlines[] = {state.alphaActive ? state.alphaDeadline : 0,
+            state.decreaseActive ? state.decreaseDeadline : 0,
+            state.recoveryActive ? state.recoveryDeadline : 0};
+        for (Tick deadline : deadlines) {
+            if (deadline && (!next || deadline < next)) {
+                next = deadline;
+            }
+        }
+    }
+    if (next) {
+        if (dcqcnEvent.scheduled()) {
+            rnic->reschedule(dcqcnEvent, next, true);
+        } else {
+            rnic->schedule(dcqcnEvent, next);
+        }
+    } else if (dcqcnEvent.scheduled()) {
+        rnic->deschedule(dcqcnEvent);
+    }
