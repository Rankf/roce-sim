+void
+HanGuRnic::RdmaEngine::markPacketSent(EthPacketPtr packet, uint32_t qpn) {
+    auto window = sndWindowList.find(qpn);
+    if (window == sndWindowList.end() || !window->second->list) {
+        return;
+    }
+    for (auto &entry : *window->second->list) {
+        if (entry->txPkt == packet) {
+            entry->sent = true;
+        }
+    }
+    if (window->second->recovering) {
+        bool allSent = true;
+        for (const auto &entry : *window->second->list) {
+            allSent = allSent && entry->sent;
+        }
+        if (allSent) {
+            HANGU_PRINT(RdmaEngine, " RC_RECOVERY_SENT qpn %u\n", qpn);
+        }
+    }
+    armRetransTimer();
+}
 
