+int mw_lifecycle_test(struct rdma_resc *resc) {
+    const uint32_t init_mask = IBV_QP_STATE | IBV_QP_ACCESS_FLAGS |
+        IBV_QP_PKEY_INDEX | IBV_QP_PORT;
+    const uint32_t rtr_mask = IBV_QP_STATE | IBV_QP_PATH_MTU |
+        IBV_QP_DEST_QPN | IBV_QP_RQ_PSN | IBV_QP_MAX_DEST_RD_ATOMIC;
+    const uint32_t rts_mask = IBV_QP_STATE | IBV_QP_SQ_PSN | IBV_QP_TIMEOUT |
+        IBV_QP_RETRY_CNT | IBV_QP_RNR_RETRY | IBV_QP_MAX_QP_RD_ATOMIC;
+    struct ibv_mw *mw = ibv_alloc_mw(resc->ctx, 1);
+    struct ibv_qp *qp = resc->qp[0];
+    if (mw_bind(resc, qp, mw, 0, 512, MR_FLAG_RD | MR_FLAG_WR,
+            0x4d57000000000060UL)) {
+        return 1;
+    }
+    if (ibv_modify_qp_state(resc->ctx, qp, IBV_QPS_ERR, IBV_QP_STATE) ||
+        ibv_modify_qp_state(resc->ctx, qp, IBV_QPS_RESET, IBV_QP_STATE) ||
+        ibv_modify_qp_state(resc->ctx, qp, IBV_QPS_INIT, init_mask) ||
+        ibv_modify_qp_state(resc->ctx, qp, IBV_QPS_RTR, rtr_mask) ||
+        ibv_modify_qp_state(resc->ctx, qp, IBV_QPS_RTS, rts_mask)) {
+        return 1;
+    }
+    if (mw_rdma(resc, qp, IBV_TYPE_RDMA_READ, mw->rkey, 0, 64,
+            0x4d57000000000061UL)) {
+        return 1;
+    }
+    if (mw_rdma(resc, resc->qp[1], IBV_TYPE_RDMA_READ, mw->rkey, 0, 64,
+            0x4d57000000000062UL) != IBV_WC_REM_ACCESS_ERR) {
+        return 1;
+    }
+    if (rdma_recv_sync(resc) || rdma_recv_sync(resc)) {
+        return 1;
+    }
+    int mr_status = mw_rdma(resc, qp, IBV_TYPE_RDMA_READ, mw->rkey, 0, 64,
+        0x4d57000000000063UL);
+    if (mr_status != IBV_WC_REM_ACCESS_ERR) {
+        return 1;
+    }
+    ibv_dealloc_mw(resc->ctx, mw);
+    if (rdma_recv_sync(resc)) {
+        return 1;
+    }
+    int status = mw_rdma(resc, qp, IBV_TYPE_RDMA_READ, mw->rkey, 0, 64,
+        0x4d57000000000064UL);
+    RDMA_PRINT(Server,
+        "MW07_SUMMARY qpn_mismatch=10 mr_invalid_status=%u dealloc_status=%u\n",
+        mr_status, status);
+    return status != IBV_WC_REM_ACCESS_ERR;
+}
