+void
+HanGuRnic::RdmaEngine::queueTxPacket(EthPacketPtr packet, uint32_t qpn) {
+    queueTxPacket(TxQueueEntry(packet, qpn, qpGeneration[qpn]));
+}
+
+void
+HanGuRnic::RdmaEngine::queueTxPacket(const TxQueueEntry &source) {
+    if (!source.packet) {
+        return;
+    }
+    if (source.generation != qpGeneration[source.qpn]) {
+        ++pacerStaleDrops;
+        HANGU_PRINT(RdmaEngine, " PACER_STALE_DROP qpn %u generation %lu\n",
+            source.qpn, source.generation);
+        return;
+    }
+    TxQueueEntry entry = source;
+    entry.sequence = ++txSequence;
+    entry.macControl = PFC::isPfc(entry.packet->data, entry.packet->length);
+    entry.priority = entry.macControl ? 0 :
+        PFC::priority(PFC::dscp(entry.packet->data));
+    entry.paced = !entry.macControl && (rnic->params()->enable_pacing ||
+        rnic->params()->enable_dcqcn) && isPaced(RoCEv2::opcode(entry.packet->data));
+    if (entry.paced) {
+        pacerState(entry.qpn);
+    }
+    txsauFifo.push_back(entry);
+    armSau();
+}
+
+void
+HanGuRnic::RdmaEngine::armSau() {
+    expirePfc();
     if (txsauFifo.empty()) {
+        if (sauEvent.scheduled()) {
+            rnic->deschedule(sauEvent);
+        }
         return;
     }
+    Tick next = 0;
+    for (const auto &entry : txsauFifo) {
+        Tick candidate = curTick() + rnic->clockPeriod();
+        if (!entry.macControl && pfcPaused(entry.priority)) {
+            candidate = std::max<Tick>(candidate, pfcPauseUntil[entry.priority]);
+        }
+        if (entry.paced) {
+            const DCQCN::State &state = pacerState(entry.qpn);
+            if (state.nextSend > curTick()) {
+                candidate = std::max<Tick>(candidate, state.nextSend);
+            }
+        }
+        if (!next || candidate < next) {
+            next = candidate;
+        }
+    }
+    if (sauEvent.scheduled()) {
+        rnic->reschedule(sauEvent, next, true);
+    } else {
+        rnic->schedule(sauEvent, next);
+    }
+}
 
