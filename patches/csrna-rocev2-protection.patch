 void
+HanGuRnic::RdmaEngine::atomicRpuProcessing(EthPacketPtr rxPkt, QpcResc *qpc) {
+    uint8_t opcode = RoCEv2::opcode(rxPkt->data);
+    uint32_t psn = RoCEv2::psn(rxPkt->data);
+    uint64_t remoteAddr = RoCEv2::atomicAddr(rxPkt->data);
+    MrReqRspPtr request = make_shared<MrReqRsp>(DMA_TYPE_AMO,
+        MR_RCHNL_RX_DATA, RoCEv2::atomicKey(rxPkt->data), sizeof(uint64_t),
+        remoteAddr & 0xFFF);
+    request->vaddr = remoteAddr;
+    request->hasVaddr = true;
+    request->pd = qpc->pd;
+    request->remote = true;
+    request->qpc = new QpcResc(*qpc);
+    request->qpGeneration = qpGeneration[qpc->srcQpn];
+    request->requestPkt = rxPkt;
+    request->atomicOpcode = opcode;
+    request->atomicSwapOrAdd = RoCEv2::atomicSwapOrAdd(rxPkt->data);
+    request->atomicCompare = RoCEv2::atomicCompare(rxPkt->data);
+    request->rdDataRsp = new uint8_t[sizeof(uint64_t)];
+    atomicResponses[qpc->srcQpn][psn] = AtomicResponseState();
+    ++destReadOutstanding[qpc->srcQpn];
+    HANGU_PRINT(RdmaEngine,
+        " ATOMIC_REQUEST qpn %u PSN 0x%x opcode 0x%x addr 0x%lx operand 0x%lx compare 0x%lx\n",
+        qpc->srcQpn, psn, opcode, remoteAddr,
+        request->atomicSwapOrAdd, request->atomicCompare);
+    rnic->dataReqFifo.push(request);
+    if (!rnic->mrRescModule.transReqEvent.scheduled()) {
+        rnic->schedule(rnic->mrRescModule.transReqEvent,
+            curTick() + rnic->clockPeriod());
+    }
+}
